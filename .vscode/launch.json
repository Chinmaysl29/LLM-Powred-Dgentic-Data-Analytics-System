{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Python in Dev Container (port 8001)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.main:app", "--host", "0.0.0.0", "--port", "8001"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "DATABASE_URL": "postgresql+psycopg://postgres:postgres@postgres:5432/ai_analyst",
        "REDIS_URL": "redis://redis:6379/0", "CHROMA_HOST": "chromadb", "CHROMA_PORT": "8000"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Backend: attach to Docker debug task",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "pathMappings": [{ "localRoot": "${workspaceFolder}", "remoteRoot": "/workspace" }],
      "justMyCode": true
    },
    {
      "name": "Frontend: browser (running Docker frontend)",
      "type": "pwa-msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ]
}
