# ==========================================================
# AI DATA ANALYST OS - ENVIRONMENT CONFIGURATION
# ==========================================================

# ==========================================================
# APPLICATION
# ==========================================================

APP_NAME=AI Data Analyst OS
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
BACKGROUND_WORKER_CONCURRENCY=1
# Disable on the API when running python -m backend.jobs.job_worker separately.
BACKGROUND_WORKER_ENABLED=true
# Optional hard-failure evidence only; no routing or training changes.
LEARNING_ENABLED=false

# ==========================================================
# LLM PROVIDERS
# ==========================================================

GROQ_API_KEY=

GEMINI_API_KEY=

OPENAI_API_KEY=

# Default LLM Models
DEFAULT_LLM=llama-3.3-70b-versatile
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==========================================================
# HUGGINGFACE
# ==========================================================

HUGGINGFACE_API_KEY=

# ==========================================================
# POSTGRESQL DATABASE
# ==========================================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=ai_analyst
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ai_analyst
# Keep local until scripts/migrate_to_supabase.py has verified the hosted copy.
DATABASE_TARGET=local
# Server-only Session pooler URI from Supabase Connect; never use VITE_* here.
SUPABASE_DATABASE_URL=

# ==========================================================
# REDIS CACHE
# ==========================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ==========================================================
# CHROMADB VECTOR DATABASE
# ==========================================================

CHROMA_HOST=chromadb
CHROMA_PORT=8000

CHROMA_PERSIST_DIR=/chroma

# ==========================================================
# JWT AUTHENTICATION
# ==========================================================

JWT_SECRET_KEY=GENERATE_A_RANDOM_LOCAL_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================================
# LANGCHAIN
# ==========================================================

LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=AI-Data-Analyst-OS

LANGSMITH_API_KEY=

# ==========================================================
# FINANCIAL DATA APIS
# ==========================================================

ALPHA_VANTAGE_API_KEY=

FINNHUB_API_KEY=

# ==========================================================
# NEWS & SENTIMENT
# ==========================================================

NEWS_API_KEY=

# ==========================================================
# FORECASTING CONFIGURATION
# ==========================================================

FORECAST_HORIZON_DAYS=30
DEFAULT_TIME_SERIES_MODEL=prophet

# ==========================================================
# RAG CONFIGURATION
# ==========================================================

RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

TOP_K_DOCUMENTS=5

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==========================================================
# TEXT TO SQL CONFIGURATION
# ==========================================================

SQL_AGENT_MAX_ITERATIONS=10
SQL_AGENT_TIMEOUT=60

# ==========================================================
# FILE UPLOADS
# ==========================================================

MAX_FILE_SIZE_MB=100

ALLOWED_FILE_TYPES=csv,xlsx,xls,json,parquet

UPLOAD_DIR=uploads

# ==========================================================
# DASHBOARD & VISUALIZATION
# ==========================================================

DEFAULT_CHART_ENGINE=plotly

# ==========================================================
# MONITORING
# ==========================================================

ENABLE_METRICS=true
ENABLE_AUDIT_LOGS=true

# ==========================================================
# CORS
# ==========================================================

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================================
# SUPABASE INTEGRATION
# ==========================================================
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_SUPABASE_KEY
SUPABASE_JWT_AUD=authenticated

# Fresh development volumes only: matches backend/requirements.txt exactly.
# Existing Chroma volumes require compatibility/backup review before changing this.
CHROMA_IMAGE=chromadb/chroma:0.6.3

# Optional bounded data processing. Existing .env files need no edits.
DATAPLANE_ENABLED=false
DATAPLANE_ENGINE_DEFAULT=duckdb
DATAPLANE_MEMORY_MB=512
DATAPLANE_WORKER_MEMORY_MB=1024
DATAPLANE_THREADS=2
DATAPLANE_TIMEOUT_S=120
DATAPLANE_SPILL_MB=2048
DATAPLANE_UPLOAD_MB=100
DATAPLANE_SCAN_MB=4096
DATAPLANE_RESULT_ROWS=5000
DATAPLANE_RESULT_BYTES=1048576
DATAPLANE_ROOT=/app/storage/dataplane
# Empty by default: customer database connections require an explicit host allowlist.
DATAPLANE_POSTGRES_HOSTS=
# Scheduled snapshot checks are off until an administrator configures monitoring.
DATAPLANE_MONITORING_ENABLED=false

