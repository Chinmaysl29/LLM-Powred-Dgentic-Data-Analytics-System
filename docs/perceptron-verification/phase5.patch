+    assert set(stored['metadatas'][0]) == {'tenant_id', 'workspace_id', 'actor_id', 'dataset_id',
+        'dataset_version', 'schema_hash', 'intent', 'embedding_version'}
+
+
+@pytest.mark.parametrize('change', ['question', 'dataset', 'version', 'legacy', 'schema'])
