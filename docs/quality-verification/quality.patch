+  flex-direction: column;
+  gap: 10px;
+  padding: 2px 0;
+}
+
+.eda-quality-item {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.eda-quality-label-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+
+.eda-quality-name {
+  font-size: 11px;
+  font-weight: 500;
+  color: #aeb5af;
+}
+
+.eda-quality-score {
+  font-size: 11px;
+  font-weight: 700;
+  font-variant-numeric: tabular-nums;
+  color: #f4f5f0;
+}
+
+.eda-quality-track {
+  height: 4px;
+  background: #1a2020;
+  border-radius: 2px;
+  overflow: hidden;
+}
+
+.eda-quality-fill {
+  height: 100%;
+  border-radius: 2px;
+  background: #d6fa43;
+  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+.eda-quality-fill-warn {
+  background: #f59e0b;
+}
+.eda-quality-fill-err {
+  background: #ef4444;
+}
+
+/* =========================================================================
+   DATA TABLE (scrollable, compact)
+   ========================================================================= */
+
+.eda-table-wrap {
+  overflow-x: auto;
+  padding-bottom: 4px;
+}
+
+.eda-table {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: 10px;
+  font-family: ui-monospace, Consolas, monospace;
+}
+
+.eda-table th {
+  padding: 7px 10px;
+  text-align: left;
+  font-size: 9px;
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: 0.08em;
+  color: #5a6a6a;
+  border-bottom: 1px solid #1e2828;
+  white-space: nowrap;
+}
+
+.eda-card-light .eda-table th {
+  color: #9ca3af;
+  border-bottom-color: #d8d8d0;
+}
+
+.eda-table td {
+  padding: 6px 10px;
+  color: #aeb5af;
+  border-bottom: 1px solid #181c1c;
+  white-space: nowrap;
+}
+
+.eda-card-light .eda-table td {
+  color: #374151;
+  border-bottom-color: #e5e5dc;
+}
+
+.eda-table tr:hover td {
+  background: rgba(255, 255, 255, 0.02);
+}
+
+.eda-table td.lime {
+  color: #d6fa43;
+  font-weight: 600;
+}
+.eda-table td.ok {
+  color: #6ee7b7;
+}
+.eda-table td.warn {
+  color: #fbbf24;
+}
+.eda-table td.err {
+  color: #f87171;
+}
+
+/* =========================================================================
+   INSIGHT CARDS (EDA Findings)
+   ========================================================================= */
+
+.eda-insight-list {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  padding: 2px 0;
+}
+
+.eda-insight-item {
+  padding: 10px 12px;
+  background: #0e1111;
+  border: 1px solid #1e2828;
+  border-radius: 6px;
+  display: flex;
+  flex-direction: column;
+  gap: 3px;
+}
+
+.eda-card-light .eda-insight-item {
+  background: #e8e8e0;
+  border-color: #d0d0c8;
+}
+
+.eda-insight-category {
+  font-size: 9px;
+  font-weight: 700;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: #d6fa43;
+}
+
+.eda-insight-title {
+  font-size: 11px;
+  font-weight: 600;
+  color: #f4f5f0;
+  line-height: 1.3;
+}
+
+.eda-card-light .eda-insight-title {
+  color: #161a16;
+}
+
+.eda-insight-text {
+  font-size: 11px;
+  color: #7a8a8a;
+  line-height: 1.5;
+}
+
+.eda-card-light .eda-insight-text {
+  color: #6b7280;
+}
+
+.eda-insight-impact {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  font-size: 9px;
+  font-weight: 600;
+  margin-top: 2px;
+}
+
+.eda-insight-impact.high {
+  color: #f87171;
+}
+.eda-insight-impact.medium {
+  color: #fbbf24;
+}
+.eda-insight-impact.low {
+  color: #6ee7b7;
+}
+
+/* =========================================================================
+   MISSING VALUES MATRIX
+   ========================================================================= */
+
+.eda-missing-list {
+  display: flex;
+  flex-direction: column;
+  gap: 5px;
+}
+
+.eda-missing-row {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.eda-missing-col-name {
+  font-size: 10px;
+  font-family: ui-monospace, Consolas, monospace;
+  color: #7a8a8a;
+  min-width: 110px;
+  max-width: 110px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.eda-missing-bar-track {
+  flex: 1;
+  height: 14px;
+  background: #1a2020;
+  border-radius: 2px;
+  overflow: hidden;
+}
+
+.eda-missing-bar-fill {
+  height: 100%;
+  background: #f59e0b;
+  border-radius: 2px;
+  transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+.eda-missing-pct {
+  font-size: 10px;
+  font-weight: 600;
+  font-variant-numeric: tabular-nums;
+  color: #f59e0b;
+  min-width: 38px;
+  text-align: right;
+}
+
+/* =========================================================================
+   DISTRIBUTION HISTOGRAM (inline SVG)
+   ========================================================================= */
+
+.eda-dist-select {
+  background: #0e1111;
+  border: 1px solid #2a3030;
+  color: #aeb5af;
+  font-size: 11px;
+  font-family: inherit;
+  padding: 5px 8px;
+  border-radius: 5px;
+  outline: none;
+  margin-bottom: 10px;
+  cursor: pointer;
+}
+
+.eda-dist-select:focus {
+  border-color: #d6fa43;
+}
+
+/* =========================================================================
+   TREND INDICATOR
+   ========================================================================= */
+
+.eda-trend-row {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.eda-trend-item {
+  padding: 10px 12px;
+  background: #0e1111;
+  border: 1px solid #1e2828;
+  border-radius: 6px;
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
+}
+
+.eda-trend-dir {
+  width: 32px;
+  height: 32px;
+  border-radius: 6px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+  font-size: 14px;
+}
+
+.eda-trend-dir.growth {
+  background: rgba(110, 231, 183, 0.1);
+  color: #6ee7b7;
+}
+.eda-trend-dir.decline {
+  background: rgba(248, 113, 113, 0.1);
+  color: #f87171;
+}
+.eda-trend-dir.stable {
+  background: rgba(214, 250, 67, 0.1);
+  color: #d6fa43;
+}
+.eda-trend-dir.fluctuating {
+  background: rgba(251, 191, 36, 0.1);
+  color: #fbbf24;
+}
+
+.eda-trend-meta {
+  flex: 1;
+  min-width: 0;
+}
+
+.eda-trend-col {
+  font-size: 11px;
+  font-weight: 600;
+  color: #f4f5f0;
+}
+
+.eda-trend-desc {
+  font-size: 10px;
+  color: #7a8a8a;
+  margin-top: 2px;
+  line-height: 1.4;
+}
+
+.eda-trend-rate {
+  font-size: 13px;
+  font-weight: 700;
+  font-variant-numeric: tabular-nums;
+  color: #d6fa43;
+  flex-shrink: 0;
+}
+
+/* =========================================================================
+   OUTLIER PANEL
+   ========================================================================= */
+
+.eda-outlier-col-select {
+  background: #0e1111;
+  border: 1px solid #2a3030;
+  color: #aeb5af;
+  font-size: 11px;
+  font-family: inherit;
+  padding: 5px 8px;
+  border-radius: 5px;
+  outline: none;
+  margin-bottom: 10px;
+  cursor: pointer;
+  width: 100%;
+}
+
+.eda-outlier-col-select:focus {
+  border-color: #d6fa43;
+}
+
+.eda-outlier-methods {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 8px;
+}
+
+.eda-outlier-method {
+  background: #0e1111;
+  border: 1px solid #1e2828;
+  border-radius: 6px;
+  padding: 10px;
+}
+
+.eda-outlier-method-name {
+  font-size: 9px;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.1em;
+  color: #5a6a6a;
+  margin-bottom: 6px;
+}
+
+.eda-outlier-count {
+  font-size: 18px;
+  font-weight: 800;
+  font-variant-numeric: tabular-nums;
+  color: #f59e0b;
+  line-height: 1;
+  margin-bottom: 2px;
+}
+
+.eda-outlier-pct {
+  font-size: 10px;
+  color: #7a8a8a;
+}
+
+/* =========================================================================
+   CARD CONTROLS (expand, inspect, export)
+   ========================================================================= */
+
+.eda-card-controls {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  flex-shrink: 0;
+}
+
+.eda-ctrl-btn {
+  width: 26px;
+  height: 26px;
+  border-radius: 5px;
+  border: 1px solid #1e2828;
+  background: transparent;
+  color: #5a6a6a;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  cursor: pointer;
+  transition:
+    border-color 0.15s,
+    color 0.15s,
+    background 0.15s;
+  font-family: inherit;
+  padding: 0;
+}
+
+.eda-ctrl-btn:hover {
+  border-color: #d6fa43;
+  color: #d6fa43;
+  background: rgba(214, 250, 67, 0.06);
+}
+
+.eda-card-light .eda-ctrl-btn {
+  border-color: #d0d0c8;
+  color: #9ca3af;
+}
+
+.eda-card-light .eda-ctrl-btn:hover {
+  border-color: #101313;
+  color: #101313;
+  background: rgba(0, 0, 0, 0.06);
+}
+
+/* =========================================================================
+   SEGMENTATION / CATEGORY PILLS
+   ========================================================================= */
+
+.eda-pill-list {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 5px;
+}
+
+.eda-pill {
+  font-size: 10px;
+  font-weight: 500;
+  padding: 3px 8px;
+  border-radius: 3px;
+  background: #1a2020;
+  border: 1px solid #2a3030;
+  color: #7a8a8a;
+}
+
+.eda-pill-lime {
+  background: rgba(214, 250, 67, 0.08);
+  border-color: rgba(214, 250, 67, 0.25);
+  color: #d6fa43;
+}
+
+/* =========================================================================
+   RESPONSIVE OVERRIDES
+   ========================================================================= */
+
+@media (max-width: 600px) {
+  .eda-header {
+    padding: 20px 16px 16px;
+  }
+
+  .eda-header-title {
+    font-size: 20px;
+  }
+
+  .eda-meta-bar {
+    padding: 8px 16px;
+  }
+
+  .eda-stat-value {
+    font-size: 18px;
+  }
+
+  .eda-stat-grid,
+  .eda-stat-grid-4 {
+    grid-template-columns: repeat(2, 1fr);
+  }
+
+  .eda-heatmap-wrap {
+    padding: 0 12px 12px;
+  }
+
+  .eda-bar-label {
+    min-width: 60px;
+    max-width: 60px;
+  }
+}
+
+/* =========================================================================
+   SKELETON LOADER
+   ========================================================================= */
+
+.eda-skeleton {
+  background: linear-gradient(90deg, #1a2020 25%, #222828 50%, #1a2020 75%);
+  background-size: 200% 100%;
+  animation: eda-shimmer 1.4s infinite;
+  border-radius: 4px;
+}
+
+@keyframes eda-shimmer {
+  0% {
+    background-position: 200% 0;
+  }
+  100% {
+    background-position: -200% 0;
+  }
+}
+
+.eda-skeleton-h12 {
+  height: 12px;
+}
+.eda-skeleton-h20 {
+  height: 20px;
+}
+.eda-skeleton-h32 {
+  height: 32px;
+}
+.eda-skeleton-h80 {
+  height: 80px;
+}
+.eda-skeleton-h140 {
+  height: 140px;
+}
+.eda-skeleton-w60 {
+  width: 60%;
+}
+.eda-skeleton-w80 {
+  width: 80%;
+}
+.eda-skeleton-w100 {
+  width: 100%;
+}
+
+/* =========================================================================
+   FOCUS / ACCESSIBILITY
+   ========================================================================= */
+
+.eda-run-btn:focus-visible,
+.eda-secondary-btn:focus-visible,
+.eda-ctrl-btn:focus-visible,
+.eda-dataset-select:focus-visible {
+  outline: 2px solid #d6fa43;
+  outline-offset: 2px;
+}
