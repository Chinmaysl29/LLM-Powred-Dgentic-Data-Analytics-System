-export type GeoMatch =
-  | { type: 'country'; id: string; country: WorldCountryShape }
-  | { type: 'region'; region: string }
-  | null;
-
-export function normalizeGeoLocation(rawInput: unknown): GeoMatch {
-  if (rawInput === null || rawInput === undefined) return null;
-  const str = String(rawInput).trim().toLowerCase();
-  if (!str) return null;
-
-  // Check direct ISO code (case-insensitive)
-  const upper = str.toUpperCase();
-  if (COUNTRY_BY_ID.has(upper)) {
-    return { type: 'country', id: upper, country: COUNTRY_BY_ID.get(upper)! };
-  }
-
-  // Check country alias
-  const aliasId = COUNTRY_ALIASES[str];
-  if (aliasId && COUNTRY_BY_ID.has(aliasId)) {
-    return { type: 'country', id: aliasId, country: COUNTRY_BY_ID.get(aliasId)! };
-  }
-
-  // Check exact country name
-  for (const country of WORLD_MAP_COUNTRIES) {
-    if (country.name.toLowerCase() === str) {
-      return { type: 'country', id: country.id, country };
-    }
-  }
-
-  // Check region alias
-  const matchedRegion = REGION_ALIASES[str];
-  if (matchedRegion) {
-    return { type: 'region', region: matchedRegion };
-  }
-
-  return null;
-}
