+/**
+ * EDA Visualization Studio — Design System
+ * 
+ * Color tokens from design brief:
+ *   Primary dark surface:    #101313
+ *   Primary light surface:   #F0F0E9
+ *   Lime accent:             #D6FA43
+ *   Primary dark text:       #161A16
+ *   Primary light text:      #F4F5F0
+ *   Secondary muted text:    #AEB5AF
+ *
+ * Layout: Asymmetric 12-column CSS bento grid.
+ * Cards alternate charcoal / off-white surfaces.
+ * Lime accent highlights key metrics only.
+ */
+
+/* =========================================================================
+   EDA PAGE SHELL
+   ========================================================================= */
+
+.eda-studio {
+  min-height: 100vh;
+  background: #0e1111;
+  font-family: 'Inter', system-ui, 'Segoe UI', sans-serif;
+  color: #f4f5f0;
+  padding: 0 0 80px 0;
+}
+
+/* =========================================================================
+   EDA HEADER
+   ========================================================================= */
+
+.eda-header {
+  border-bottom: 1px solid rgba(214, 250, 67, 0.12);
+  padding: 28px 32px 24px;
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
+}
+
+@media (min-width: 768px) {
+  .eda-header {
+    flex-direction: row;
+    align-items: flex-end;
+    justify-content: space-between;
+  }
+}
+
+.eda-header-eyebrow {
+  font-size: 10px;
+  font-weight: 600;
+  letter-spacing: 0.12em;
+  color: #d6fa43;
+  text-transform: uppercase;
+  margin-bottom: 6px;
+}
+
+.eda-header-title {
+  font-size: 26px;
+  font-weight: 700;
+  letter-spacing: -0.03em;
+  color: #f4f5f0;
+  margin: 0 0 4px;
+  line-height: 1.1;
+}
+
+.eda-header-sub {
+  font-size: 12px;
+  color: #aeb5af;
+  margin: 0;
+  font-weight: 400;
+}
+
+/* =========================================================================
+   DATASET SELECTOR TOOLBAR
+   ========================================================================= */
+
+.eda-toolbar {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  flex-wrap: wrap;
+}
+
+.eda-dataset-select {
+  background: #181c1c;
+  border: 1px solid #2a3030;
+  color: #f4f5f0;
+  font-size: 12px;
+  font-family: inherit;
+  padding: 8px 12px;
+  border-radius: 6px;
+  outline: none;
+  cursor: pointer;
+  min-width: 200px;
+  transition: border-color 0.15s;
+}
+
+.eda-dataset-select:focus {
+  border-color: #d6fa43;
+}
+
+.eda-run-btn {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  background: #d6fa43;
+  color: #101313;
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.02em;
+  padding: 8px 18px;
+  border-radius: 6px;
+  border: none;
+  cursor: pointer;
+  transition:
+    background 0.15s,
+    transform 0.1s;
+  font-family: inherit;
+}
+
+.eda-run-btn:hover {
+  background: #c8f030;
+}
+
+.eda-run-btn:active {
+  transform: scale(0.98);
+}
+
+.eda-run-btn:disabled {
+  opacity: 0.45;
+  cursor: not-allowed;
+  transform: none;
+}
+
+.eda-secondary-btn {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  background: transparent;
+  border: 1px solid #2a3030;
+  color: #aeb5af;
+  font-size: 12px;
+  font-family: inherit;
+  padding: 8px 14px;
+  border-radius: 6px;
+  cursor: pointer;
+  transition:
+    border-color 0.15s,
+    color 0.15s;
+}
+
+.eda-secondary-btn:hover {
+  border-color: #aeb5af;
+  color: #f4f5f0;
+}
+
+/* =========================================================================
+   STATUS / META BAR
+   ========================================================================= */
+
+.eda-meta-bar {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  padding: 10px 32px;
+  background: #141818;
+  border-bottom: 1px solid #1e2424;
+  font-size: 11px;
+  color: #aeb5af;
+  flex-wrap: wrap;
+}
+
+.eda-meta-item {
+  display: flex;
+  align-items: center;
+  gap: 5px;
+}
+
+.eda-meta-dot {
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: #d6fa43;
+  flex-shrink: 0;
+}
+
+.eda-meta-dot.warn {
+  background: #f59e0b;
+}
+.eda-meta-dot.muted {
+  background: #3a4040;
+}
+
+/* =========================================================================
+   STATE PANELS
+   ========================================================================= */
+
+.eda-empty-state {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  min-height: 480px;
+  gap: 16px;
+  text-align: center;
+  padding: 40px;
+}
+
+.eda-empty-icon {
+  width: 56px;
+  height: 56px;
+  border-radius: 12px;
+  background: #181c1c;
+  border: 1px solid #2a3030;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  color: #3a4040;
+}
+
+.eda-empty-title {
+  font-size: 16px;
+  font-weight: 600;
+  color: #f4f5f0;
+  margin: 0;
+}
+
+.eda-empty-sub {
+  font-size: 12px;
+  color: #aeb5af;
+  margin: 0;
+  max-width: 340px;
+  line-height: 1.6;
+}
+
+.eda-error-banner {
+  margin: 24px 32px;
+  padding: 14px 18px;
+  background: rgba(239, 68, 68, 0.06);
+  border: 1px solid rgba(239, 68, 68, 0.25);
+  border-radius: 8px;
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
+  font-size: 12px;
+  color: #fca5a5;
+}
+
+.eda-loading-overlay {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  min-height: 480px;
+  gap: 14px;
+}
+
+.eda-spinner {
+  width: 28px;
+  height: 28px;
+  border: 2px solid #1e2424;
+  border-top-color: #d6fa43;
+  border-radius: 50%;
+  animation: eda-spin 0.75s linear infinite;
+}
+
+@keyframes eda-spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+.eda-loading-text {
+  font-size: 12px;
+  color: #aeb5af;
+  font-family: ui-monospace, Consolas, monospace;
+}
+
+/* =========================================================================
+   BENTO GRID SYSTEM — 12-COLUMN ASYMMETRIC
+   ========================================================================= */
+
+.eda-canvas {
+  padding: 24px 32px;
+  display: grid;
+  grid-template-columns: repeat(12, 1fr);
+  gap: 12px;
+  align-items: start;
+}
+
+@media (max-width: 1200px) {
+  .eda-canvas {
+    grid-template-columns: repeat(8, 1fr);
+  }
+}
+
+@media (max-width: 900px) {
+  .eda-canvas {
+    grid-template-columns: repeat(4, 1fr);
+  }
+}
+
+@media (max-width: 600px) {
+  .eda-canvas {
+    grid-template-columns: 1fr;
+    padding: 16px;
+    gap: 10px;
+  }
+}
+
+/* Column span utilities */
+.eda-span-12 {
+  grid-column: span 12;
+}
+.eda-span-8 {
+  grid-column: span 8;
+}
+.eda-span-7 {
+  grid-column: span 7;
+}
+.eda-span-6 {
+  grid-column: span 6;
+}
+.eda-span-5 {
+  grid-column: span 5;
+}
+.eda-span-4 {
+  grid-column: span 4;
+}
+.eda-span-3 {
+  grid-column: span 3;
+}
+
+@media (max-width: 1200px) {
+  .eda-span-12,
+  .eda-span-8,
+  .eda-span-7 {
+    grid-column: span 8;
+  }
+  .eda-span-6,
+  .eda-span-5 {
+    grid-column: span 4;
+  }
+  .eda-span-4,
+  .eda-span-3 {
+    grid-column: span 4;
+  }
+}
+
+@media (max-width: 900px) {
+  .eda-span-12,
+  .eda-span-8,
+  .eda-span-7,
+  .eda-span-6,
+  .eda-span-5,
+  .eda-span-4,
+  .eda-span-3 {
+    grid-column: span 4;
+  }
+}
+
+@media (max-width: 600px) {
+  .eda-span-12,
+  .eda-span-8,
+  .eda-span-7,
+  .eda-span-6,
+  .eda-span-5,
+  .eda-span-4,
+  .eda-span-3 {
+    grid-column: span 1;
+  }
+}
+
+/* =========================================================================
+   VISUALIZATION CARDS
+   ========================================================================= */
+
+/* Dark surface card (primary) */
+.eda-card {
+  background: #141818;
+  border: 1px solid #1e2828;
+  border-radius: 8px;
+  overflow: hidden;
+  display: flex;
+  flex-direction: column;
+  transition: border-color 0.2s;
+}
+
+.eda-card:hover {
+  border-color: #2a3838;
+}
+
+/* Light surface card (alternating) */
+.eda-card-light {
+  background: #f0f0e9;
+  border: 1px solid #d8d8d0;
+  border-radius: 8px;
+  overflow: hidden;
+  display: flex;
+  flex-direction: column;
+}
+
+.eda-card-light .eda-card-eyebrow {
+  color: #6b7280;
+}
+.eda-card-light .eda-card-title {
+  color: #161a16;
+}
+.eda-card-light .eda-card-body {
+  color: #374151;
+}
+.eda-card-light .eda-stat-value {
+  color: #101313;
+}
+.eda-card-light .eda-stat-label {
+  color: #6b7280;
+}
+.eda-card-light .eda-section-divider {
+  background: #d8d8d0;
+}
+
+/* Lime accent card */
+.eda-card-lime {
+  background: #d6fa43;
+  border: 1px solid #c8f030;
+  border-radius: 8px;
+  overflow: hidden;
+  display: flex;
+  flex-direction: column;
+}
+
+.eda-card-lime .eda-card-eyebrow {
+  color: #4a5a00;
+}
+.eda-card-lime .eda-card-title {
+  color: #101313;
+}
+.eda-card-lime .eda-stat-value {
+  color: #101313;
+}
+.eda-card-lime .eda-stat-label {
+  color: #4a5a00;
+}
+
+/* =========================================================================
+   CARD ANATOMY
+   ========================================================================= */
+
+.eda-card-header {
+  padding: 16px 18px 12px;
+  border-bottom: 1px solid #1e2828;
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 10px;
+  flex-shrink: 0;
+}
+
+.eda-card-light .eda-card-header {
+  border-bottom-color: #d8d8d0;
+}
+.eda-card-lime .eda-card-header {
+  border-bottom-color: rgba(0, 0, 0, 0.12);
+}
+
+.eda-card-header-left {
+  flex: 1;
+  min-width: 0;
+}
+
+.eda-card-eyebrow {
+  font-size: 9px;
+  font-weight: 700;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: #aeb5af;
+  margin-bottom: 4px;
+}
+
+.eda-card-title {
+  font-size: 13px;
+  font-weight: 700;
+  color: #f4f5f0;
+  margin: 0;
+  letter-spacing: -0.01em;
+  line-height: 1.3;
+}
+
+.eda-card-desc {
+  font-size: 10px;
+  color: #5a6a6a;
+  margin: 3px 0 0;
+  line-height: 1.4;
+}
+
+.eda-card-light .eda-card-desc {
+  color: #9ca3af;
+}
+
+.eda-card-badge {
+  font-size: 9px;
+  font-weight: 600;
+  padding: 3px 7px;
+  border-radius: 3px;
+  background: rgba(214, 250, 67, 0.1);
+  color: #d6fa43;
+  letter-spacing: 0.06em;
+  white-space: nowrap;
+  flex-shrink: 0;
+}
+
+.eda-card-body {
+  padding: 16px 18px;
+  flex: 1;
+  color: #aeb5af;
+  font-size: 12px;
+}
+
+.eda-section-divider {
+  height: 1px;
+  background: #1e2828;
+  margin: 0;
+}
+
+/* =========================================================================
+   KPI STAT ATOMS
+   ========================================================================= */
+
+.eda-stat-grid {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 1px;
+  background: #1e2828;
+}
+
+.eda-stat-grid-2 {
+  grid-template-columns: repeat(2, 1fr);
+}
+.eda-stat-grid-4 {
+  grid-template-columns: repeat(4, 1fr);
+}
+
+.eda-stat-cell {
+  background: #141818;
+  padding: 14px 16px;
+  display: flex;
+  flex-direction: column;
+  gap: 3px;
+}
+
+.eda-card-light .eda-stat-cell {
+  background: #f0f0e9;
+}
+.eda-card-lime .eda-stat-cell {
+  background: #d6fa43;
+}
+
+.eda-stat-value {
+  font-size: 22px;
+  font-weight: 800;
+  font-variant-numeric: tabular-nums;
+  letter-spacing: -0.03em;
+  color: #f4f5f0;
+  line-height: 1;
+}
+
+.eda-stat-value-sm {
+  font-size: 15px;
+  font-weight: 700;
+  font-variant-numeric: tabular-nums;
+  color: #f4f5f0;
+  line-height: 1.2;
+}
+
+.eda-stat-value-lime {
+  color: #d6fa43;
+}
+.eda-stat-value-warn {
+  color: #f59e0b;
+}
+.eda-stat-value-ok {
+  color: #6ee7b7;
+}
+
+.eda-stat-label {
+  font-size: 10px;
+  color: #5a6a6a;
+  font-weight: 500;
+  text-transform: uppercase;
+  letter-spacing: 0.07em;
+}
+
+/* =========================================================================
+   INLINE MINI CHARTS (SVG-based, no dependencies)
+   ========================================================================= */
+
+.eda-chart-wrap {
+  width: 100%;
+  overflow: hidden;
+}
+
+.eda-chart-svg {
+  width: 100%;
+  display: block;
+}
+
+.eda-chart-caption {
+  font-size: 10px;
+  color: #3a4a4a;
+  padding: 6px 18px 14px;
+  line-height: 1.4;
+}
+
+.eda-card-light .eda-chart-caption {
+  color: #9ca3af;
+}
+
+/* =========================================================================
+   CORRELATION HEATMAP GRID
+   ========================================================================= */
+
+.eda-heatmap-wrap {
+  overflow-x: auto;
+  padding: 0 18px 16px;
+}
+
+.eda-heatmap-table {
+  border-collapse: collapse;
+  font-size: 9px;
+  color: #aeb5af;
+  font-family: ui-monospace, Consolas, monospace;
+  min-width: 100%;
+}
+
+.eda-heatmap-table th {
+  padding: 4px 6px;
+  text-align: center;
+  font-weight: 500;
+  white-space: nowrap;
+  max-width: 70px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.eda-heatmap-table td {
+  width: 36px;
+  height: 30px;
+  text-align: center;
+  font-size: 9px;
+  font-weight: 600;
+  border: 1px solid #0e1111;
+  border-radius: 2px;
+  cursor: default;
+  transition: filter 0.1s;
+}
+
+.eda-heatmap-table td:hover {
+  filter: brightness(1.3);
+}
+
+/* =========================================================================
+   BAR CHART ROWS (horizontal, category comparison)
+   ========================================================================= */
+
+.eda-bar-rows {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding: 2px 0 4px;
+}
+
+.eda-bar-row {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.eda-bar-label {
+  font-size: 10px;
+  color: #aeb5af;
+  min-width: 80px;
+  max-width: 80px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  text-align: right;
+  flex-shrink: 0;
+}
+
+.eda-card-light .eda-bar-label {
+  color: #6b7280;
+}
+
+.eda-bar-track {
+  flex: 1;
+  height: 18px;
+  background: #1a2020;
+  border-radius: 3px;
+  overflow: hidden;
+  position: relative;
+}
+
+.eda-card-light .eda-bar-track {
+  background: #e5e5dc;
+}
+
+.eda-bar-fill {
+  height: 100%;
+  border-radius: 3px;
+  background: #2a3838;
+  transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
+  position: relative;
+}
+
+.eda-bar-fill-lime {
+  background: #d6fa43;
+}
+.eda-bar-fill-teal {
