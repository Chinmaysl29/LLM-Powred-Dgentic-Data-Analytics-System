+            </g>
+          ))}
+        </svg>
+      </div>
+      <p className="chart-scope">
+        {categoriesShown.length} of {categories.length} categories · {data.aggregation} ·{' '}
+        {data.unit}. Missing combinations are not plotted. Numbers identify series.
