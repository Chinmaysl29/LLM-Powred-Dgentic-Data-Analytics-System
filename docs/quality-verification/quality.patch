+/* ---------------------------------------------------------------------------
+   Analysis to visualization loading
+   ------------------------------------------------------------------------- */
+
+.analysis-viz-loader {
+  width: min(680px, 100%);
+  margin: 28px auto 0;
+  padding: 22px;
+  border: 1px solid rgba(218, 232, 250, 0.09);
+  border-radius: 14px;
+  background: linear-gradient(145deg, rgba(19, 25, 37, 0.88), rgba(9, 12, 20, 0.92));
+  box-shadow: 0 22px 60px rgba(0, 0, 0, 0.26);
+  text-align: center;
+}
+
+.analysis-viz-animation {
+  width: min(420px, 100%);
+  margin: 0 auto;
+}
+
+.analysis-viz-animation svg {
+  display: block;
+  width: 100%;
+}
+
+.analysis-loader-grid {
+  fill: none;
+  stroke: rgba(190, 210, 238, 0.08);
+  stroke-width: 1;
+}
+
+.analysis-loader-radial {
+  animation: loader-pulse 2.4s ease-in-out infinite;
+}
+
+.analysis-loader-flow {
+  fill: none;
+  stroke: url(#loaderLine);
+  stroke-width: 3;
+  stroke-linecap: round;
+  stroke-dasharray: 420;
+  animation: loader-draw 1.9s ease-in-out infinite alternate;
+}
+
+.analysis-loader-points circle {
+  fill: #d7e9f0;
+  opacity: 0.68;
+  animation: loader-float 2.8s ease-in-out infinite;
+}
+
+.analysis-loader-bubbles circle {
+  fill: rgba(255, 184, 107, 0.12);
+  stroke: rgba(255, 184, 107, 0.45);
+  animation: loader-float 3.2s ease-in-out infinite reverse;
+}
+
+.analysis-viz-copy h2 {
+  margin: 4px 0 7px;
+  color: #f7fbff;
+  font-size: 24px;
+  letter-spacing: 0;
+}
+
+.analysis-viz-copy p {
