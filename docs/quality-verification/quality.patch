+
+.cinematic-tour-link {
+  font-size: 0.8125rem;
+  font-weight: 600;
+  color: var(--login-text-secondary);
+  text-decoration: none;
+  transition: color 0.15s ease;
+}
+
+.cinematic-tour-link:hover {
