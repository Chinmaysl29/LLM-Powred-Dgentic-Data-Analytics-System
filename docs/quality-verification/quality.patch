+// ---------------------------------------------------------------------------
+// Card 05 — Correlation Heatmap
+// ---------------------------------------------------------------------------
+function Card05Correlation({ results }: { results: EDAResults }) {
+  const matrix = results.correlations.correlation_matrix;
+  const cols = Object.keys(matrix).slice(0, 7);
