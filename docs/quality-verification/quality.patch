-/* -------------------------------------------------------------------------
-   3. Pill Navbar
-   ------------------------------------------------------------------------- */
-
-.landing-nav {
-  display: flex;
-  align-items: center;
-  gap: 4px;
-  padding: 7px 8px 7px 12px;
-  background: rgba(20, 20, 20, 0.75);
-  border: 1px solid rgba(255, 255, 255, 0.12);
-  border-radius: 9999px;
-  box-shadow:
-    0 2px 8px rgba(0, 0, 0, 0.4),
