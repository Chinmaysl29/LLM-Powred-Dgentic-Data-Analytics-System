+
+export interface TreemapNode {
+  id: string;
+  label: string;
+  parent?: string;
+  value: number;
+  percent: number;
+  colorIndex: number;
+}
+
+export interface TreemapData {
+  items: TreemapNode[];
+  total: number;
+}
+
+export interface TableColumnDef {
+  key: string;
+  label: string;
