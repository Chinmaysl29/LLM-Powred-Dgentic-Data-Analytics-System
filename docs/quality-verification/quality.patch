+    id: string;
+    type: string;
+    title: string;
+    points: { label: string; value: number | null; count?: number }[];
+  }[];
+}
+interface DashboardResponse extends Omit<
+  DashboardSnapshot,
+  'kpis' | 'sample_rows' | 'total_rows' | 'dataset_id'
+> {
+  dataset_id?: string;
+  provenance?: { dataset_id?: string };
+  filtered_rows?: number;
+  population_size?: number;
+  kpis: { id: string; label: string; value: number | null }[];
+}
+function finiteKpis(kpis: DashboardResponse['kpis']): DashboardSnapshot['kpis'] {
+  return kpis
+    .filter(
+      (k): k is DashboardSnapshot['kpis'][number] =>
+        typeof k.value === 'number' && Number.isFinite(k.value),
+    )
+    .map(({ id, label, value }) => ({ id, label, value }));
+}
+const STORAGE_KEY = 'analyst.dashboard.snapshot.v1';
+function readSnapshot(storageKey: string): DashboardSnapshot | null {
