-          <div style={{ fontWeight: 700, color: '#ffb8d9', fontSize: '12px' }}>
-            {hoveredCountry.country.name}
-          </div>
-          <div style={{ color: '#ffffff', marginTop: '2px', fontWeight: 600 }}>
-            {hoveredCountry.sales > 0
