+@media (max-width: 768px) {
+  /* On mobile, the sidebar becomes a full-width drawer regardless of collapsed/expanded state.
+     The ws-sidebar--open class (added by mobileOpen state) slides it into view.
+     The ws-sidebar--collapsed class is irrelevant on mobile since the drawer shows full labels. */
+  .ws-sidebar,
+  .ws-sidebar.ws-sidebar--collapsed {
+    width: 260px !important;
+    overflow-y: auto !important;
+    overflow-x: hidden !important;
+  }
+  /* Mobile drawer: always show brand text, full-width nav links */
+  .ws-sidebar--collapsed .ws-sidebar-brand {
+    flex-direction: row !important;
+    justify-content: space-between !important;
+    padding: 18px 16px 14px !important;
+  }
+  .ws-sidebar--collapsed .ws-sidebar-brand-text {
+    display: inline !important;
+    opacity: 1 !important;
+  }
+  /* NOTE: ws-new-analysis-label, ws-nav-label, ws-nav-section-label are conditionally
+     rendered in JSX based on !isCollapsed state. On mobile the drawer is opened via
+     mobileOpen (separate from isCollapsed), so labels may not show for collapsed+mobile.
+     The mobile drawer should reset the collapsed nav-link sizing: */
+  .ws-sidebar--collapsed .ws-nav-link {
+    width: 100% !important;
+    height: auto !important;
+    padding: 8px 10px !important;
+    justify-content: flex-start !important;
+    margin: 0 !important;
+  }
+  /* Tooltips are not needed in mobile drawer mode */
+  .ws-sidebar--collapsed .ws-tooltip {
+    display: none !important;
+  }
+  .ws-sidebar--collapsed .ws-collapse-toggle {
+    display: none !important;
+  }
+  .ws-sidebar-mobile-close {
+    display: flex !important;
+  }
+  /* On mobile, main content always starts at left edge (no sidebar offset) */
+  .ws-main,
+  .ws-main.ws-main--collapsed,
+  .ws-main.ws-main--expanded {
+    margin-left: 0 !important;
+  }
+}
+
+/* Sleek custom scrollbars for sidebar */
+.ws-sidebar {
+  scrollbar-width: thin;
+  scrollbar-color: rgba(255, 255, 255, 0.12) transparent;
+}
+.ws-sidebar::-webkit-scrollbar {
+  width: 5px;
+}
+.ws-sidebar::-webkit-scrollbar-track {
+  background: transparent;
+}
+.ws-sidebar::-webkit-scrollbar-thumb {
+  background: rgba(255, 255, 255, 0.12);
+  border-radius: 4px;
+}
+.ws-sidebar::-webkit-scrollbar-thumb:hover {
+  background: rgba(255, 255, 255, 0.25);
+}
+.ws-sidebar.ws-sidebar--collapsed {
+  overflow: visible !important;
+  overflow-y: visible !important;
+  overflow-x: visible !important;
+  scrollbar-width: none !important;
+  -ms-overflow-style: none !important;
+}
+.ws-sidebar.ws-sidebar--collapsed::-webkit-scrollbar {
+  display: none !important;
+}
+.ws-sidebar--collapsed .ws-sidebar-nav,
+.ws-sidebar--collapsed .ws-nav-group {
+  overflow: visible !important;
+}
+.ws-sidebar--collapsed .ws-tooltip {
+  left: calc(100% + 20px) !important;
+  z-index: 9999 !important;
+}
