+  min-width: 0;
+  border: 1px solid rgba(210, 227, 249, 0.1);
+  border-radius: 8px;
+  background: linear-gradient(145deg, rgba(18, 26, 42, 0.93), rgba(13, 18, 30, 0.94));
+  box-shadow: 0 14px 30px rgba(0, 0, 0, 0.18);
+}
+
+.viz-card {
+  grid-column: span 3;
+  overflow: hidden;
+}
+
+.viz-card--wide {
+  grid-column: span 4;
+}
+
+.viz-chart-grid-area > .viz-card:nth-child(2) {
+  grid-column: span 2;
+}
+
+.viz-card-header {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 14px 14px 8px;
+}
+
+.viz-card-header.compact {
+  display: block;
+}
+
+.viz-card-header h2,
+.viz-builder h2,
+.viz-insight h3,
+.viz-recent h3 {
+  margin: 0;
+  color: rgba(246, 250, 255, 0.93);
+  font-size: 14px;
+  font-weight: 650;
+  letter-spacing: 0;
+}
+
+.viz-card-header a {
+  color: #6eeaff;
+  font-size: 12px;
+  text-decoration: none;
+}
+
+.viz-card-header button {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  min-height: 30px;
+  border-radius: 7px;
+  padding: 0 9px;
+  font-size: 12px;
+}
+
+.viz-line-chart {
+  display: block;
+  width: calc(100% - 28px);
+  height: 212px;
+  margin: 6px 14px 12px;
+  overflow: visible;
+}
+
+.viz-chart-grid {
+  fill: none;
+  stroke: rgba(206, 224, 247, 0.1);
+  stroke-width: 1;
+  stroke-dasharray: 3 4;
+}
+
+.viz-chart-area {
+  fill: url(#vizRevenueArea);
+}
+.viz-chart-line {
+  fill: none;
+  stroke: url(#vizRevenueLine);
+  stroke-width: 4;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+.viz-chart-guide {
+  stroke: rgba(255, 255, 255, 0.18);
+  stroke-dasharray: 3 4;
+}
+.viz-chart-point {
+  fill: #64f2ff;
+  stroke: #172235;
+  stroke-width: 3;
+}
+.viz-axis-labels text {
+  fill: rgba(216, 228, 244, 0.58);
+  font-size: 11px;
+}
+
+.viz-donut-wrap {
+  display: grid;
+  grid-template-columns: 150px minmax(0, 1fr);
+  align-items: center;
+  gap: 14px;
+  padding: 16px 14px 20px;
+}
+
+.viz-donut {
+  display: grid;
+  width: 142px;
+  aspect-ratio: 1;
+  place-items: center;
+  border-radius: 50%;
+  background: conic-gradient(
+    #4294ff 0 35%,
+    #e368f1 35% 60%,
+    #55d5ff 60% 80%,
+    #23d6e4 80% 92%,
+    #2ea8ef 92% 100%
+  );
+}
+
+.viz-donut::before {
+  position: absolute;
+  width: 78px;
+  aspect-ratio: 1;
+  border-radius: 50%;
+  content: '';
+  background: #101827;
+}
+
+.viz-donut > div {
+  position: relative;
+  z-index: 1;
+  display: grid;
+  text-align: center;
+}
+
+.viz-donut strong {
+  color: #fff;
+  font-size: 20px;
+}
+.viz-donut span {
+  color: rgba(221, 231, 244, 0.63);
+  font-size: 12px;
+}
+
+.viz-legend {
+  display: grid;
+  gap: 11px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.viz-legend li {
+  display: grid;
+  grid-template-columns: 10px minmax(0, 1fr) auto;
+  align-items: center;
+  gap: 9px;
+  color: #f4f8ff;
+  font-size: 12px;
+}
+
+.viz-legend span {
+  width: 10px;
+  height: 10px;
+  border-radius: 50%;
+}
+
+.viz-legend em {
+  color: #fff;
+  font-style: normal;
+  font-weight: 700;
+}
+
+.viz-ranking {
+  display: grid;
+  gap: 8px;
+  padding: 12px 14px 16px;
+}
+
+.viz-rank-row {
+  position: relative;
+  display: grid;
+  grid-template-columns: 78px minmax(0, 1fr) 46px;
+  align-items: center;
+  gap: 8px;
+  color: rgba(242, 247, 255, 0.9);
+  font-size: 11px;
+}
+
+.viz-rank-row::before {
+  grid-column: 2;
+  height: 12px;
+  border-radius: 999px;
+  content: '';
+  background: rgba(75, 98, 141, 0.24);
+}
+
+.viz-rank-row em {
+  position: absolute;
+  left: 86px;
+  height: 12px;
+  border-radius: 999px;
+  background: linear-gradient(90deg, #25b9ff, #9d55ff);
+}
+
+.viz-rank-row b {
+  grid-column: 3;
+  color: #fff;
+  font-size: 11px;
+  text-align: right;
+}
+
+.viz-segment-bars {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  align-items: end;
+  gap: 14px;
+  height: 190px;
+  padding: 18px 16px 16px;
+}
+
+.viz-segment-bars div {
+  display: grid;
+  height: 100%;
+  align-items: end;
+  gap: 6px;
+  text-align: center;
+}
+
+.viz-segment-bars span {
+  display: block;
+  min-height: 18px;
+  border-radius: 5px 5px 0 0;
+  background: linear-gradient(180deg, #38e2df, #306eff);
+}
+
+.viz-segment-bars div:nth-child(3) span {
+  background: linear-gradient(180deg, #8b5cf6, #3c45d8);
+}
+.viz-segment-bars div:nth-child(4) span {
+  background: linear-gradient(180deg, #f65fc8, #b62e83);
+}
+.viz-segment-bars b {
+  color: #fff;
+  font-size: 12px;
+}
+.viz-segment-bars em {
+  color: rgba(220, 231, 246, 0.65);
+  font-size: 10px;
+  font-style: normal;
+}
+
+.viz-region-map {
+  position: relative;
+  min-height: 220px;
+  height: 250px;
+  margin: 0 14px 14px;
+  overflow: hidden;
+  border-radius: 8px;
+  background: #140d16;
+  border: 1px solid rgba(255, 175, 205, 0.12);
+  display: flex;
+  flex-direction: column;
+}
+
+.viz-region-map::before {
+  display: none;
+}
+
+.viz-map-svg-wrap {
+  position: relative;
+  flex: 1;
+  width: 100%;
+  min-height: 180px;
+  overflow: hidden;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.viz-map-controls {
+  position: absolute;
+  top: 10px;
+  right: 12px;
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  z-index: 10;
+}
+
+.viz-map-btn {
+  width: 26px;
+  height: 26px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: rgba(28, 16, 24, 0.85);
+  border: 1px solid rgba(255, 175, 205, 0.25);
+  border-radius: 4px;
+  color: #ffc4dc;
+  font-size: 13px;
+  font-weight: 700;
+  cursor: pointer;
+  transition: all 0.2s;
+  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
+}
+
+.viz-map-btn:hover {
+  background: rgba(95, 32, 62, 0.9);
+  color: #fff;
+  border-color: rgba(255, 185, 215, 0.6);
+  box-shadow: 0 0 10px rgba(255, 140, 185, 0.4);
+}
+
+.viz-map-legend {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 6px 14px 10px;
+  font-size: 11px;
+  color: rgba(245, 205, 225, 0.75);
+  gap: 10px;
+  z-index: 5;
+  background: linear-gradient(180deg, transparent, rgba(20, 13, 22, 0.92) 35%);
+}
+
+.viz-map-legend-bar {
+  flex: 1;
+  height: 6px;
+  border-radius: 3px;
+  background: linear-gradient(
+    90deg,
+    #4c1c32 0%,
+    #7a2c4f 25%,
+    #ac4473 50%,
+    #da6e9e 75%,
+    #f7a8c8 100%
+  );
+  box-shadow: 0 0 8px rgba(218, 110, 158, 0.3);
+}
+
+.viz-map-tooltip {
+  position: absolute;
+  pointer-events: none;
+  z-index: 30;
+  background: rgba(22, 13, 20, 0.96);
+  border: 1px solid rgba(255, 175, 210, 0.45);
+  box-shadow:
+    0 8px 24px rgba(0, 0, 0, 0.7),
+    0 0 14px rgba(255, 120, 180, 0.25);
+  border-radius: 6px;
+  padding: 6px 10px;
+  color: #ffffff;
+  font-size: 11.5px;
+  transform: translate(-50%, -100%);
+  margin-top: -8px;
+  white-space: nowrap;
+}
+
+.viz-builder {
+  position: sticky;
+  top: 78px;
+  padding: 16px;
+}
+
+.viz-builder-title {
+  display: flex;
+  gap: 10px;
+  margin-bottom: 20px;
+  color: #71efff;
+}
+
+.viz-builder fieldset {
+  margin: 0 0 16px;
+  padding: 0;
+  border: 0;
+}
+
+.viz-builder legend,
+.viz-field span {
+  margin-bottom: 7px;
+  color: rgba(230, 239, 251, 0.72);
+  font-size: 12px;
+}
+
+.viz-type-grid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 7px;
+}
+
+.viz-type {
+  display: grid;
+  min-width: 0;
+  min-height: 58px;
+  place-items: center;
+  border-radius: 7px;
+  color: rgba(230, 239, 251, 0.66);
+  font-size: 11px;
+}
+
+.viz-type--active {
+  border-color: rgba(74, 135, 255, 0.78);
+  background: rgba(43, 86, 188, 0.27);
+  color: #8ff2ff;
+  box-shadow: 0 0 0 1px rgba(74, 135, 255, 0.28) inset;
+}
+
+.viz-field {
+  display: grid;
+  gap: 6px;
+  margin-bottom: 13px;
+}
+
+.viz-field .viz-select {
+  width: 100%;
+}
+
+.viz-filter,
+.viz-update {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 9px;
+  width: 100%;
+  min-height: 42px;
+  border-radius: 7px;
+  font-size: 13px;
+}
+
+.viz-filter {
+  margin-top: 8px;
+}
+
+.viz-update {
+  margin-top: 22px;
+  border-color: transparent;
+  background: linear-gradient(90deg, #2f93ff, #7a45ff);
+  font-weight: 700;
+}
+
+.viz-update:disabled {
+  cursor: wait;
+  opacity: 0.72;
+}
+
+.viz-input {
+  min-height: 38px;
+  box-sizing: border-box;
+  width: 100%;
+  border: 1px solid rgba(210, 227, 249, 0.12);
+  border-radius: 7px;
+  padding: 0 12px;
+  background: rgba(24, 31, 48, 0.78);
+  color: rgba(235, 242, 252, 0.88);
+  font: inherit;
+  font-size: 12px;
+}
+
+.viz-input:focus-visible {
+  outline: 2px solid rgba(83, 220, 236, 0.72);
+  outline-offset: 2px;
+}
+
+.viz-filter-panel {
+  display: grid;
+  gap: 10px;
+  margin: 10px 0 12px;
+  padding: 12px;
+  border: 1px solid rgba(210, 227, 249, 0.11);
+  border-radius: 8px;
+  background: rgba(11, 16, 27, 0.86);
+}
+
+.viz-filter-actions {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 8px;
+}
+
+.viz-filter-actions button,
+.viz-filter-chips button,
+.viz-empty button {
+  min-height: 32px;
+  border: 1px solid rgba(210, 227, 249, 0.12);
+  border-radius: 7px;
+  background: rgba(24, 31, 48, 0.78);
+  color: rgba(235, 242, 252, 0.88);
+  font: inherit;
+  font-size: 12px;
+  cursor: pointer;
+}
+
+.viz-filter-chips {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 7px;
+  margin: 0 0 10px;
+}
+
+.viz-filter-chips button {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  min-height: 30px;
+  padding: 0 9px;
+  color: #91f5ff;
+}
+
+.viz-loading,
+.viz-empty {
+  display: grid;
+  min-height: 210px;
+  place-items: center;
+  padding: 20px;
+  color: rgba(222, 233, 247, 0.68);
+  font-size: 13px;
+  text-align: center;
+}
+
+.viz-empty {
+  gap: 10px;
+}
+
+.viz-empty strong {
+  color: rgba(246, 250, 255, 0.92);
+  font-size: 13px;
+}
+
+.viz-bar-chart {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(42px, 1fr));
+  align-items: end;
+  gap: 10px;
+  min-height: 212px;
+  padding: 18px 14px 14px;
+}
+
+.viz-bar-chart div {
+  display: grid;
+  height: 190px;
+  min-width: 0;
+  align-items: end;
+  gap: 6px;
+  text-align: center;
+}
+
+.viz-bar-chart span {
+  display: block;
+  min-height: 8px;
+  border-radius: 5px 5px 0 0;
+}
+
+.viz-bar-chart b,
+.viz-bar-chart em {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-size: 10px;
+  font-style: normal;
+}
+
+.viz-bar-chart b {
+  color: rgba(246, 250, 255, 0.9);
+}
+
+.viz-bar-chart em {
+  color: rgba(220, 231, 246, 0.56);
+}
+
+.viz-scatter-point {
+  fill: #64f2ff;
+  stroke: rgba(139, 92, 255, 0.72);
+  stroke-width: 2;
+  opacity: 0.82;
+}
+
+.viz-heatmap {
+  display: grid;
+  grid-template-columns: repeat(6, minmax(0, 1fr));
+  gap: 6px;
+  min-height: 210px;
+  padding: 14px;
+}
+
+.viz-heatmap span {
+  display: grid;
+  min-height: 44px;
+  place-items: center;
+  border-radius: 6px;
+  background: linear-gradient(145deg, #2f93ff, #7a45ff);
+  color: rgba(255, 255, 255, 0.92);
+  font-size: 10px;
+  text-align: center;
+}
+
+.viz-treemap {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  min-height: 210px;
+  padding: 14px;
+}
+
+.viz-treemap div {
+  display: grid;
+  min-width: 92px;
+  min-height: 72px;
+  align-content: end;
+  gap: 4px;
+  border-radius: 8px;
+  padding: 10px;
+  color: #fff;
+}
+
+.viz-treemap b,
+.viz-treemap span {
+  font-size: 11px;
+}
+
+.viz-data-table-wrap {
+  overflow-x: auto;
+  padding: 12px;
+}
+
+.viz-data-table {
+  width: 100%;
+  min-width: 420px;
+  border-collapse: collapse;
+  color: rgba(235, 242, 252, 0.86);
+  font-size: 12px;
+}
+
+.viz-data-table caption {
+  text-align: left;
+  color: rgba(214, 226, 244, 0.58);
+  margin-bottom: 8px;
+}
+
+.viz-data-table th,
+.viz-data-table td {
+  border-bottom: 1px solid rgba(210, 227, 249, 0.08);
+  padding: 9px 10px;
+  text-align: left;
+}
+
+.viz-data-table th {
+  color: rgba(214, 226, 244, 0.62);
+  font-size: 10px;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+
+.viz-donut--pie::before {
+  display: none;
+}
+
+.viz-bottom-grid {
+  display: grid;
+  grid-template-columns: 1.1fr 1fr;
+  gap: 14px;
+  margin-top: 14px;
+}
+
+.viz-insight-grid,
+.viz-recent-grid {
+  display: grid;
+  gap: 12px;
+  padding: 12px;
+}
+
+.viz-insight-grid {
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+}
+
+.viz-insight {
+  min-width: 0;
+  padding: 14px;
+  border: 1px solid rgba(210, 227, 249, 0.09);
+  border-radius: 8px;
+  background: rgba(22, 31, 48, 0.78);
+}
+
+.viz-insight svg {
+  color: #67f0ce;
+}
+.viz-insight h3 {
+  margin-top: 10px;
+  font-size: 13px;
+}
+.viz-insight p {
+  margin-top: 8px;
+  color: rgba(222, 233, 247, 0.68);
+  font-size: 12px;
+  line-height: 1.45;
+}
+
+.viz-recent-grid {
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+}
+
+.viz-recent {
+  position: relative;
+  min-width: 0;
+  overflow: hidden;
+  border: 1px solid rgba(210, 227, 249, 0.08);
+  border-radius: 8px;
