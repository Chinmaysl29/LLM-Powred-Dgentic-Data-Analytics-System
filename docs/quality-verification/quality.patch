+  outline-offset: 2px;
+}
+
+/* =========================================================================
+   Phase 2F — Dataset Upload Page
+   All classes prefixed with `upload-` to avoid collisions.
+   Uses only existing design tokens. No new CSS variables introduced.
+   ========================================================================= */
+
+/* Page header row (title left, back link right) */
+.upload-page-header-row {
+  display: flex;
