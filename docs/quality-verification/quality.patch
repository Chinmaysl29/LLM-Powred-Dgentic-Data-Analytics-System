+/* Small display of email address in step 2 */
+.av2-email-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 13px;
+  color: var(--av2-text-sub);
+  background: var(--av2-surface);
+  border: 1px solid var(--av2-border);
+  border-radius: var(--av2-radius-pill);
+  padding: 5px 14px;
+  margin-bottom: 4px;
+  max-width: 100%;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* ---------------------------------------------------------------------------
+   Responsive — navbar collapses on mobile
+   --------------------------------------------------------------------------- */
+
+@media (max-width: 600px) {
+  .av2-navbar {
+    padding: 14px 16px 0;
+  }
+
+  .av2-navbar-inner {
+    padding: 5px 5px 5px 12px;
+  }
+
+  .av2-brand-text {
+    display: none; /* icon-only on very small screens */
+  }
+
+  .av2-nav-links {
+    display: none; /* hidden on mobile */
+  }
+
+  .av2-content {
+    padding: 32px 20px 48px;
+    align-items: flex-start;
+    padding-top: 48px;
+  }
+
+  .av2-heading {
+    font-size: 30px;
+    letter-spacing: -0.8px;
+  }
+
+  .av2-subtext {
+    font-size: 15px;
