+export function forecastSeries(
+  rows: Record<string, unknown>[],
+  dateColumn: string,
+  valueColumn: string,
+) {
+  const seen = new Set<string>();
+  const series = rows.map((row, index) => {
+    const date = row[dateColumn];
+    const value = row[valueColumn];
+    if (
+      typeof date !== 'string' ||
+      !/^\d{4}-\d{2}-\d{2}/.test(date) ||
+      !Number.isFinite(Date.parse(date))
+    )
+      throw new Error(`Row ${index + 1} needs a valid ISO date in ${dateColumn}.`);
+    if (typeof value !== 'number' || !Number.isFinite(value))
+      throw new Error(`Row ${index + 1} needs a numeric value in ${valueColumn}.`);
+    const normalized = new Date(date).toISOString();
+    if (seen.has(normalized))
+      throw new Error('Duplicate timestamps need aggregation before forecasting.');
+    seen.add(normalized);
+    return { date: normalized, value };
+  });
+  if (series.length < 3)
+    throw new Error(
+      'At least three valid observations are required. Models may require more history.',
+    );
+  return series.sort((a, b) => a.date.localeCompare(b.date));
+}
