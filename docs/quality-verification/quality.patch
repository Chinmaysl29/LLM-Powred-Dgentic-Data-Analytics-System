+      typeof data.dataset_id === 'string' &&
+      Array.isArray(data.kpis) &&
+      data.kpis.every(
+        (k: { value: unknown }) => typeof k.value === 'number' && Number.isFinite(k.value),
+      )
+      ? data
+      : null;
+  } catch {
+    return null;
+  }
+}
