+                  )
+                }
+              >
+                <Download size={15} /> Download results
+              </button>
+              <div className="fw-metrics-table-wrap">
+                <table className="fw-metrics-table">
+                  <caption>Forecast values and prediction bounds</caption>
+                  <thead>
+                    <tr>
+                      <th>Date</th>
+                      <th>Forecast</th>
+                      <th>Lower bound</th>
+                      <th>Upper bound</th>
+                    </tr>
+                  </thead>
+                  <tbody>
+                    {result.dates.map((date, i) => (
+                      <tr key={`${date}-${i}`}>
+                        <td>{date}</td>
+                        <td>{result.forecast[i].toLocaleString()}</td>
+                        <td>{result.lower_bound[i].toLocaleString()}</td>
+                        <td>{result.upper_bound[i].toLocaleString()}</td>
+                      </tr>
+                    ))}
+                  </tbody>
+                </table>
+              </div>
+            </section>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
+function ForecastChart({
+  result,
+  history,
+}: {
+  result: ForecastResult;
+  history: { date: string; value: number }[];
+}) {
+  const min = Math.min(
+    ...result.lower_bound,
+    ...result.forecast,
+    ...history.map((point) => point.value),
+  );
+  const max = Math.max(
+    ...result.upper_bound,
+    ...result.forecast,
+    ...history.map((point) => point.value),
+  );
+  const range = max - min || Math.max(Math.abs(max) * 0.1, 1);
+  const timestamps = [
+    ...history.map((point) => Date.parse(point.date)),
+    ...result.dates.map((date) => Date.parse(date)),
+  ];
+  const first = Math.min(...timestamps);
+  const last = Math.max(...timestamps);
+  const atDate = (date: string) => 70 + ((Date.parse(date) - first) / (last - first || 1)) * 620;
+  const x = (i: number) => atDate(result.dates[i]);
+  const y = (v: number) => 220 - ((v - min) / range) * 180;
+  const path = result.forecast.map((v, i) => `${i ? 'L' : 'M'}${x(i)},${y(v)}`).join(' ');
+  const observed = history
+    .map((point, i) => `${i ? 'L' : 'M'}${atDate(point.date)},${y(point.value)}`)
+    .join(' ');
+  const interval = [
+    ...result.upper_bound.map((v, i) => `${x(i)},${y(v)}`),
+    ...result.lower_bound.map((v, i) => `${x(i)},${y(v)}`).reverse(),
+  ].join(' ');
+  return (
+    <svg
+      viewBox="0 0 740 280"
+      role="img"
+      aria-label={`${result.target} forecast. Exact values and prediction bounds follow in the table.`}
+      style={{ width: '100%' }}
+    >
+      {[0, 0.5, 1].map((f) => (
+        <g key={f}>
+          <line
+            x1={70}
+            x2={690}
+            y1={220 - f * 180}
+            y2={220 - f * 180}
+            stroke="currentColor"
+            opacity={0.15}
+          />
+          <text x={62} y={224 - f * 180} textAnchor="end" fill="currentColor" fontSize={10}>
+            {(min + f * range).toLocaleString(undefined, {
+              maximumFractionDigits: 1,
+              notation: 'compact',
+            })}
+          </text>
+        </g>
+      ))}
+      <polygon points={interval} fill="var(--chart-1)" opacity={0.2}>
+        <title>{result.confidence_level * 100}% prediction interval</title>
+      </polygon>
+      <path d={observed} stroke="var(--text-h)" strokeWidth={2} fill="none" />
+      <path d={path} stroke="var(--accent)" strokeWidth={2} strokeDasharray="5 4" fill="none" />
+      {result.forecast.map((v, i) => (
+        <circle key={i} cx={x(i)} cy={y(v)} r={3} fill="var(--accent)">
+          <title>
+            {result.dates[i]}: {v}
+          </title>
+        </circle>
+      ))}
+      <text x={70} y={250} fill="currentColor" fontSize={11}>
+        {new Date(first).toISOString().slice(0, 10)}
+      </text>
+      <text x={690} y={250} textAnchor="end" fill="currentColor" fontSize={11}>
+        {new Date(last).toISOString().slice(0, 10)}
+      </text>
+    </svg>
+  );
+}
