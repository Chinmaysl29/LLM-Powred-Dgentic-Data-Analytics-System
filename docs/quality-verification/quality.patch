+                fontSize: 10,
+                padding: '3px 0',
+                borderBottom: '1px solid #1A2020',
+              }}
+            >
+              <span style={{ color: '#7A8A8A' }}>
+                {shortLabel(p.column_a, 10)} × {shortLabel(p.column_b, 10)}
+              </span>
+              <span
+                style={{
+                  color: p.correlation > 0 ? '#6ee7b7' : '#f87171',
+                  fontWeight: 700,
+                  fontFamily: 'ui-monospace, monospace',
+                }}
+              >
+                {p.correlation.toFixed(3)}
+              </span>
+            </div>
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
