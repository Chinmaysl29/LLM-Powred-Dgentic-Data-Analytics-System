-/* Product refinement: shared solid surfaces and accessible interaction tokens.
-   Existing page selectors remain intact to preserve layout and data contracts. */
-*, *::before, *::after { box-sizing: border-box; }
-button, input, select, textarea { font: inherit; }
-button, [role="button"] { border-radius: var(--radius-control); }
-:where(a, button, input, select, textarea, [tabindex]):focus-visible {
-  outline: 2px solid var(--focus);
-  outline-offset: 3px;
-}
-:where(input, textarea)::placeholder { color: var(--text-muted); opacity: 1; }
-:where(table, .dataset-stat-value, .kpi-value, .ws-kpi-value) { font-variant-numeric: tabular-nums; }
-:where(.btn, .auth-submit) { min-height: 40px; border-radius: var(--radius-control); }
-.btn--primary, .auth-submit { background: var(--accent-strong); color: #fff; }
-.btn--primary:hover:not(:disabled) { box-shadow: none; background: #2e70c7; }
-.page-subtitle { opacity: 1; }
-.ws-layout, .ws-main, .analysis-workspace-inner, .viz-workspace { background: var(--bg); }
-.ws-sidebar, .ws-topbar, .analysis-composer::after, .profile-overview-card { background: var(--surface); }
-.ws-sidebar-brand-dot { background: var(--surface-raised); border-color: var(--border); border-radius: 7px; box-shadow: none; }
-.ws-nav-link:hover, .ws-nav-link.active, .ws-nav-link[aria-current="page"] { background: var(--accent-bg); }
-.analysis-composer { border-radius: var(--radius-card); box-shadow: none; }
-.analysis-composer::before, .analysis-workspace-inner::after, .viz-workspace::before,
-.av2-layout::before, .av2-layout::after { display: none; }
-.text-shimmer { background: none; color: var(--text); -webkit-text-fill-color: currentColor; animation: none; }
-.profile-avatar-large { background: var(--surface-raised); box-shadow: none; }
-.ws-main, .analysis-workspace-inner, .viz-workspace { background: var(--bg); }
-.ws-new-analysis, .ws-new-analysis:hover { background: var(--accent-bg); }
-.ws-topbar-avatar, .ws-profile-avatar, .ws-hero-mark { background: var(--surface-raised); box-shadow: none; }
-.viz-kpi, .viz-card, .viz-builder, .analysis-viz-loader { background: var(--surface); }
-.ws-main .datasets-upload-btn, .reports-create-btn, .reports-create-btn:hover,
-.viz-update { background: var(--accent-strong); box-shadow: none; }
-.viz-tab--active::after, .viz-rank-row em, .viz-segment-bars span,
-.viz-segment-bars div:nth-child(3) span, .viz-segment-bars div:nth-child(4) span,
-.viz-mini-bars span, .viz-mini-bars span:nth-child(4) { background: var(--accent); }
-.skeleton { background: var(--surface-raised); animation: none; }
-.av2-layout {
-  --av2-bg: var(--bg);
-  --av2-surface: var(--surface);
-  --av2-surface-hov: var(--surface-raised);
-  --av2-border: var(--border);
-  --av2-text: var(--text-h);
-  --av2-text-muted: var(--text-muted);
-  --av2-text-sub: var(--text);
-  --av2-radius-pill: var(--radius-control);
-  --av2-radius-card: var(--radius-card);
-}
-.av2-content { padding: 56px 20px; }
-.av2-card { padding: 32px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-card); }
-.av2-heading { font: 600 28px/1.25 var(--sans); letter-spacing: -0.5px; }
-.av2-submit, .av2-submit:hover, .av2-nav-signup, .av2-nav-signup:hover { box-shadow: none; }
-.product-home { min-height: 100svh; background: var(--bg); color: var(--text); }
-.product-header, .product-footer {
-  width: min(1160px, 100%);
-  margin: 0 auto;
-  padding: 24px 32px;
-  display: flex;
-  align-items: center;
-  justify-content: space-between;
-  gap: 24px;
-}
-.product-header { min-height: 88px; border-bottom: 1px solid var(--border); }
-.product-header nav, .product-footer nav { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
-.product-header a, .product-footer a { color: var(--text); text-decoration: none; font-size: 14px; }
-.product-header a:hover, .product-footer a:hover { color: var(--text-h); }
-.product-header .product-brand { display: flex; align-items: center; gap: 10px; color: var(--text-h); font-size: 16px; font-weight: 600; }
