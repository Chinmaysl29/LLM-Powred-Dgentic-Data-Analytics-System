+                      ))}
+                    </tbody>
+                  </table>
+                </div>
+              </details>
+              <button
+                className="btn btn--ghost"
+                onClick={() =>
+                  downloadWorkbenchJson(
+                    { dataset_id: datasetId, sample_rows: preview?.rows.length, result },
