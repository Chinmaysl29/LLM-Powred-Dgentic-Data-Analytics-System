+    </motion.h3>
+  );
+}
+
+// ---------------------------------------------------------------------------
+// CardCurtainRevealDescription — description visible in revealed state
+// ---------------------------------------------------------------------------
+
+interface CardCurtainRevealDescriptionProps {
