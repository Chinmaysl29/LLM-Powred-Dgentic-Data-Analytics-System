+          <select
+            className="eda-dist-select"
+            value={yCol}
+            onChange={(e) => setYCol(e.target.value)}
+            aria-label="Y axis column"
+            style={{ flex: 1, minWidth: 0 }}
+          >
+            {numCols.map((c) => (
+              <option key={c} value={c}>
+                {c}
+              </option>
+            ))}
+          </select>
+        </div>
+
+        {corrVal != null && (
+          <div
+            style={{
+              padding: '12px',
+              background: '#0e1111',
+              borderRadius: 6,
+              marginBottom: 10,
+              textAlign: 'center',
