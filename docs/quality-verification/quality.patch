+                  <UploadCloud className="w-8 h-8" />
+                </div>
+                <div>
+                  <p className="text-base font-medium text-zinc-200">Drop Files Here</p>
+                  <p className="text-xs text-zinc-400 mt-1">or browse files from your computer</p>
