+                className="profile-btn-danger"
+                disabled={confirmationInput !== 'DELETE' || isDeleting}
+                onClick={handleDelete}
+              >
+                {isDeleting ? (
+                  <>
+                    <Loader2 size={15} className="profile-spinner" />
+                    Processing...
+                  </>
+                ) : (
+                  'Delete Account'
+                )}
+              </button>
+            </div>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+};
