-/* =========================================================================
-   Landing Page
-   Phase 3 — Frontend only. Uses existing design tokens plus landing-specific
-   values scoped under .landing-* namespace to prevent collisions.
-   ========================================================================= */
-
-/* -------------------------------------------------------------------------
-   1. Page Shell
-   ------------------------------------------------------------------------- */
-
-.landing-page {
-  min-height: 100svh;
-  /* Near-black cinematic base — Reference Image 2 */
-  background-color: #050505;
-  position: relative;
-  overflow-x: hidden;
-  display: flex;
-  flex-direction: column;
-}
-
-/* Skip-to-content link for keyboard users */
-.landing-skip-link {
-  position: absolute;
-  top: -100%;
-  left: 50%;
-  transform: translateX(-50%);
-  background: #0d0c10;
-  color: #fff;
-  font-size: 14px;
-  font-weight: 500;
-  padding: 8px 20px;
-  border-radius: 0 0 8px 8px;
-  text-decoration: none;
-  z-index: 9999;
-  transition: top 0.15s;
-}
-
-.landing-skip-link:focus {
-  top: 0;
-}
-
-/* =========================================================================
-   Background Layer System
-   Four composited layers that recreate the cinematic environment
-   from the reference image. All layers: position:absolute, pointer-events:none.
-   z-index stack: grid(0) → atmosphere(1) → glow(2) → sphere(3) → hero(5)
-   ========================================================================= */
-
-/* -------------------------------------------------------------------------
-   Layer 1: Architectural grid
-   Thin horizontal + vertical lines at low opacity, fading toward light.
-   ------------------------------------------------------------------------- */
-.lp-grid {
-  position: absolute;
-  inset: 0;
-  /*
-    Reference-matching grid:
-    - ~72px cells (medium architectural density — matches reference)
-    - Lines at 11% opacity: clearly visible but not distracting
-    - Monochromatic dark-gray (no color tint)
-    - Mask fades grid into brightening lower region so dome can shine through
-    - Extended mask stops at 92% so grid remains subtly detectable behind the
-      atmospheric glow — creating layered depth (grid → glow → horizon).
-  */
-  background-image:
-    linear-gradient(rgba(255, 255, 255, 0.11) 1px, transparent 1px),
-    linear-gradient(90deg, rgba(255, 255, 255, 0.11) 1px, transparent 1px);
-  background-size: 72px 72px;
-  /* Extended fade — grid ghosted behind glow rather than fully removed */
-  mask-image: linear-gradient(
-    to bottom,
-    rgba(0, 0, 0, 1)    0%,
-    rgba(0, 0, 0, 1)    45%,
-    rgba(0, 0, 0, 0.55) 68%,
-    rgba(0, 0, 0, 0.18) 82%,
-    rgba(0, 0, 0, 0)    92%
-  );
-  -webkit-mask-image: linear-gradient(
-    to bottom,
-    rgba(0, 0, 0, 1)    0%,
-    rgba(0, 0, 0, 1)    45%,
-    rgba(0, 0, 0, 0.55) 68%,
-    rgba(0, 0, 0, 0.18) 82%,
-    rgba(0, 0, 0, 0)    92%
-  );
-  pointer-events: none;
-  z-index: 0;
-}
-
-/* -------------------------------------------------------------------------
-   Layer 2: Grayscale atmospheric gradient
-   Multiple radial + linear gradients creating smooth light build-up.
-   ------------------------------------------------------------------------- */
-.lp-atmosphere {
-  position: absolute;
-  inset: 0;
-  background:
-    /*
-      Refined atmosphere — layered top-to-bottom illumination.
-      Five layers to create smooth zone transitions:
-
-      A: Vast lower ellipse — primary light pool rising from the dome..
-         Extra-wide so edges bleed far out of frame.
-    */
-    radial-gradient(ellipse 180% 90% at 50% 115%,
-      rgba(220, 220, 220, 0.26) 0%,
-      rgba(180, 180, 180, 0.10) 38%,
-      transparent               62%
-    ),
-
-    /* B: Mid-cone — the tighter hot-spot immediately above the rim */
-    radial-gradient(ellipse 110% 65% at 50% 102%,
-      rgba(170, 170, 170, 0.22) 0%,
-      rgba(130, 130, 130, 0.09) 42%,
-      transparent               62%
-    ),
-
-    /* C: Near-dome hotspot — concentrated brightness at horizon */
-    radial-gradient(ellipse 85% 50% at 50% 96%,
-      rgba(210, 210, 210, 0.20) 0%,
-      rgba(160, 160, 160, 0.06) 45%,
-      transparent               60%
-    ),
-
-    /* D: Vertical depth wash — creates Zone A→B gradient from dark top to warm base */
-    linear-gradient(to bottom,
-      transparent               0%,
-      transparent              28%,
-      rgba(30,  30,  30,  0.08) 52%,
-      rgba(55,  55,  55,  0.20) 72%,
-      rgba(30,  30,  30,  0.28) 100%
-    ),
-
-    /* E: Very faint upper central column — ties glow to hero heading zone */
-    radial-gradient(ellipse 55% 40% at 50% 60%,
-      rgba(255, 255, 255, 0.015) 0%,
-      transparent                80%
-    );
-  pointer-events: none;
-  z-index: 1;
-}
-
-/* -------------------------------------------------------------------------
-   Layer 3: Central volumetric glow
-   Very broad, extremely low-opacity soft white glow centered above ellipse.
-   Creates the "light diffusing through fog" appearance.
-   ------------------------------------------------------------------------- */
-.lp-glow {
-  position: absolute;
-  inset: 0;
-  /*
-    Refined atmospheric volumetric glow.
-
-    Five graduated layers that create distinct depth zones:
-      Zone A (upper hero) — almost black, grid visible
-      Zone B (mid hero)   — very soft atmospheric gray/white wash
-      Zone C (horizon)    — concentrated bright glow above curve rim
-
-    The glow reaches significantly higher into the hero so the
-    content floats in a haze rather than sitting on a blank background.
-  */
-  background:
-    /* A — extremely vast outer aura; the farthest, most diffused envelope */
-    radial-gradient(ellipse 160% 80% at 50% 86%,
-      rgba(255, 255, 255, 0.07)  0%,
-      rgba(255, 255, 255, 0.032) 38%,
-      rgba(255, 255, 255, 0.008) 62%,
-      transparent                78%
-    ),
-    /* B — broad mid-spread: primary atmospheric illumination band */
-    radial-gradient(ellipse 115% 62% at 50% 91%,
-      rgba(255, 255, 255, 0.130) 0%,
-      rgba(255, 255, 255, 0.060) 36%,
-      rgba(255, 255, 255, 0.014) 62%,
-      transparent                78%
-    ),
-    /* C — medium inner cone: Zone B→C bright transition */
-    radial-gradient(ellipse 80%  48% at 50% 94%,
-      rgba(255, 255, 255, 0.180) 0%,
-      rgba(255, 255, 255, 0.090) 30%,
-      rgba(255, 255, 255, 0.022) 58%,
-      transparent                72%
-    ),
-    /* D — Zone C hot zone: tightest, brightest, immediately above rim */
-    radial-gradient(ellipse 60%  30% at 50% 97%,
-      rgba(255, 255, 255, 0.150) 0%,
-      rgba(255, 255, 255, 0.075) 28%,
-      rgba(255, 255, 255, 0.018) 55%,
-      transparent                68%
-    ),
-    /* E — faint central column rising into the hero body (Zone A→B connector) */
-    radial-gradient(ellipse 45%  72% at 50% 68%,
-      rgba(255, 255, 255, 0.028) 0%,
-      rgba(255, 255, 255, 0.010) 45%,
-      transparent                70%
-    );
-  pointer-events: none;
-  z-index: 2;
-}
-
-/* -------------------------------------------------------------------------
-   Layer 4: Giant glowing dark ellipse
-   The primary visual spectacle. A massive CSS border-radius ellipse with
-   multi-layer box-shadow creating the bright white rim + bloom effect.
-   Sits BEHIND hero content (z-index: 3 < hero's z-index: 5).
-   Wide enough to bleed past both viewport edges.
-   ------------------------------------------------------------------------- */
-.lp-sphere {
-  position: absolute;
-  /*
-    Sphere positioning — rim appears at ~74-78% from top of viewport.
-    All hero content (badge, heading, subheading, CTA) sits comfortably
-    above the rim with generous breathing room.
-
-    Calculation: rim_top_from_bottom = height - |bottom| = 82vh - 56vh = 26vh
-    → rim is at 100vh - 26vh = 74% from the top of the viewport.
-    The CTA button at ~60-65% from top has ~9-14% gap above the rim.
-  */
-  bottom: -56vh;
-  left: 50%;
-  transform: translateX(-50%);
-  /*
-    Width: extremely wide (180vw) so the curve is flattened into a
-    near-flat horizon — the center rises only ~2-3° above the edges,
-    matching the "distant planet edge" aesthetic rather than a visible oval.
-  */
-  width: 180vw;
-  max-width: 3200px;
-  /*
-    Height: generous so the arc is broad and the rim isn't overly curved.
-    Taller sphere = flatter visible arc.
-  */
-  height: 82vh;
-  min-height: 480px;
-  border-radius: 50%;
-  /*
-    Dark interior — near the rim a subtle lighter edge catches the glow;
-    deepens to pure black inside. Creates the "deep surface" below the horizon.
-  */
-  background: radial-gradient(
-    ellipse 100% 18% at 50% 0%,
-    #1a1a1a 0%,
-    #0c0c0c 10%,
-    #060606 28%,
-    #020202 55%,
-    #010101 100%
-  );
-  /*
-    Seven-layer box-shadow for the refined rim:
-
-    Layer 1 — hair-thin crisp luminous line (the polished rim edge)
-    Layer 2 — immediate tight bloom (1-4px above rim)
-    Layer 3 — close halo (4-16px above rim)
-    Layer 4 — medium glow envelope (16-50px)
-    Layer 5 — large atmospheric bloom (50-140px)
-    Layer 6 — vast outer atmospheric wash (140-320px)
-    Layer 7 — horizon atmospheric tail (320-600px)
-
-    This produces the sharp-edge-then-soft-bloom hierarchy.
-  */
-  box-shadow:
-    0    0px   0px   1px  rgba(255, 255, 255, 0.98),
-    0   -2px   6px   0px  rgba(255, 255, 255, 0.82),
-    0   -6px  18px   0px  rgba(255, 255, 255, 0.52),
-    0  -16px  50px   0px  rgba(255, 255, 255, 0.28),
-    0  -45px 140px   0px  rgba(255, 255, 255, 0.14),
-    0 -100px 320px   0px  rgba(255, 255, 255, 0.07),
-    0 -200px 600px   0px  rgba(255, 255, 255, 0.03);
-  pointer-events: none;
-  z-index: 3;
-}
-
-/*
-  lp-sphere::after — hair-thin crisp white ring on top of the box-shadow bloom.
-
-  The box-shadow approach has a physical limit: spread/blur slightly
-  rounds the very apex of the rim. The ::after pseudo-element adds a
-  dedicated opaque ring inset 1px from the outer edge that reads as a
-  laser-precise luminous line without affecting the soft glow cascade above.
-
-  It sits at z-index 4 (just above the sphere surface) and is masked
-  to only the top 15% of the circle so it doesn't bleed downward.
-*/
-.lp-sphere::after {
-  content: '';
-  position: absolute;
-  inset: 0;
-  border-radius: 50%;
-  /*
-    Radial gradient that creates a pure bright ring only at the very top
-    of the ellipse — falls off to transparent within the first 6%.
-    This complements the box-shadow rim without doubling the glow.
-  */
-  background: radial-gradient(
-    ellipse 100% 8% at 50% 0%,
-    rgba(255, 255, 255, 0.30) 0%,
-    rgba(255, 255, 255, 0.10) 45%,
-    transparent               100%
-  );
-  pointer-events: none;
-}
-
-/* -------------------------------------------------------------------------
-   2. Navbar Wrapper — entrance animation
