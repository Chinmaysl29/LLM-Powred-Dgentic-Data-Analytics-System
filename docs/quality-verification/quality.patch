+  scatter_bounds?: { minX: number; maxX: number; minY: number; maxY: number } | null;
+  histogram_bins?:
+    { bin_start: number; bin_end: number; count: number; percentage: number }[] | null;
+  summary_metrics?: Record<string, number>;
+}
+
+export const workbenchService = {
+  async datasets(signal?: AbortSignal) {
+    const all: SourceDataset[] = [];
+    for (let skip = 0; ; skip += 100) {
+      const page = await apiClient.get<SourceDataset[]>('/api/v1/datasets', {
+        signal,
+        params: { skip: String(skip), limit: '100' },
+      });
+      if (!Array.isArray(page))
+        throw new Error('The dataset service returned an invalid response.');
+      all.push(...page);
+      if (page.length < 100) return all;
+    }
+  },
+  preview(id: string, signal?: AbortSignal) {
