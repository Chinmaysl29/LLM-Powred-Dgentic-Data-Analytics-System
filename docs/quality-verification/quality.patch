+import { useEffect, useState } from 'react';
+export interface Appearance {
+  theme: 'light' | 'dark' | 'system';
+  reducedMotion: boolean;
+  density: 'comfortable' | 'compact';
+  accent: 'lime' | 'sage';
+}
+export const DEFAULT_APPEARANCE: Appearance = {
+  theme: 'light',
+  reducedMotion: false,
+  density: 'comfortable',
+  accent: 'lime',
+};
+const KEY = 'analyst-os-appearance';
+function read(): Appearance {
+  try {
+    const value = JSON.parse(localStorage.getItem(KEY) ?? '{}');
+    return {
+      theme: ['light', 'dark', 'system'].includes(value.theme) ? value.theme : 'light',
+      reducedMotion: value.reducedMotion === true,
+      density: value.density === 'compact' ? 'compact' : 'comfortable',
+      accent: value.accent === 'sage' ? 'sage' : 'lime',
+    };
+  } catch {
+    return DEFAULT_APPEARANCE;
+  }
+}
+export function useAppearance() {
+  const [appearance, setAppearance] = useState(read);
+  const [storageError, setStorageError] = useState('');
+  useEffect(() => {
+    const sync = () => setAppearance(read());
+    window.addEventListener('storage', sync);
+    window.addEventListener('appearance-change', sync);
+    return () => {
+      window.removeEventListener('storage', sync);
+      window.removeEventListener('appearance-change', sync);
+    };
+  }, []);
+  function update(value: Appearance) {
+    try {
+      localStorage.setItem(KEY, JSON.stringify(value));
+      setStorageError('');
+      setAppearance(value);
+      window.dispatchEvent(new Event('appearance-change'));
+    } catch {
+      setStorageError('Browser storage is unavailable. Preferences could not be saved.');
+    }
+  }
+  return { appearance, update, storageError };
+}
+export function useApplyAppearance() {
+  const { appearance } = useAppearance();
+  useEffect(() => {
+    const query = window.matchMedia('(prefers-color-scheme: dark)');
+    const apply = () => {
+      document.documentElement.dataset.theme =
+        appearance.theme === 'system' ? (query.matches ? 'dark' : 'light') : appearance.theme;
+      document.documentElement.dataset.motion = appearance.reducedMotion ? 'reduce' : 'system';
+      document.documentElement.dataset.density = appearance.density;
+      document.documentElement.dataset.accent = appearance.accent;
+    };
+    apply();
+    query.addEventListener('change', apply);
+    return () => query.removeEventListener('change', apply);
+  }, [appearance]);
+}
diff --git a/frontend/src/hooks/useAsyncResource.ts b/frontend/src/hooks/useAsyncResource.ts
new file mode 100644
--- /dev/null
+++ b/frontend/src/hooks/useAsyncResource.ts
@@ -0,0 +1,38 @@
+import { useEffect, useMemo, useState } from 'react';
+
+type Loader<T> = (signal: AbortSignal) => Promise<T>;
+
+/** Keep results tied to their request, and ignore completions after cancellation.
+ * Pass a stable (useCallback) loader, or null to disable the request.
+ */
+export function useAsyncResource<T>(load: Loader<T> | null, revision = 0) {
+  const request = useMemo(() => ({ load, revision }), [load, revision]);
+  const [result, setResult] = useState<{
+    request: typeof request;
+    data?: T;
+    error?: string;
+  }>();
+
+  useEffect(() => {
+    const { load } = request;
+    if (!load) return;
+    const controller = new AbortController();
+    void (async () => {
+      try {
+        const data = await load(controller.signal);
+        if (!controller.signal.aborted) setResult({ request, data });
+      } catch (error) {
+        if (!controller.signal.aborted) {
+          setResult({
+            request,
+            error: error instanceof Error ? error.message : 'Unable to load data.',
+          });
+        }
+      }
+    })();
+    return () => controller.abort();
+  }, [request]);
+
+  const current = load && result?.request === request ? result : undefined;
+  return { data: current?.data, error: current?.error ?? '', loading: Boolean(load && !current) };
+}
