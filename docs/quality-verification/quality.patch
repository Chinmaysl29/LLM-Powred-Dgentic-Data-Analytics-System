-/**
- * Monochromatic Pink Choropleth Palette
- * Seamless continuous RGB interpolation matching reference:
- * Dark muted rose -> Dark dusty pink -> Medium pink -> Light pink -> Bright rose-pink
- */
-export function getPinkChoroplethColor(value: number, max: number): string {
-  if (!Number.isFinite(value) || value <= 0 || max <= 0) {
-    return '#1c1219'; // No sales data: subtle dark muted rose
-  }
-
-  const ratio = Math.min(1, Math.max(0, value / max));
-
-  const stops = [
-    { t: 0.0, r: 76, g: 28, b: 50 },     // #4c1c32: very low
-    { t: 0.25, r: 122, g: 44, b: 79 },   // #7a2c4f: low
-    { t: 0.5, r: 172, g: 68, b: 115 },   // #ac4473: medium
-    { t: 0.75, r: 218, g: 110, b: 158 }, // #da6e9e: high
-    { t: 1.0, r: 247, g: 168, b: 200 },  // #f7a8c8: very high / peak
-  ];
-
-  for (let i = 0; i < stops.length - 1; i++) {
-    const s1 = stops[i];
-    const s2 = stops[i + 1];
-    if (ratio >= s1.t && ratio <= s2.t) {
-      const f = (ratio - s1.t) / (s2.t - s1.t);
-      const r = Math.round(s1.r + (s2.r - s1.r) * f);
-      const g = Math.round(s1.g + (s2.g - s1.g) * f);
-      const b = Math.round(s1.b + (s2.b - s1.b) * f);
-      return `rgb(${r}, ${g}, ${b})`;
-    }
-  }
-
-  return '#f7a8c8';
-}
