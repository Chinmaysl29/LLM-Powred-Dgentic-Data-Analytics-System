+  justify-content: space-between;
+  gap: 16px;
+  flex-wrap: wrap;
+}
+
+.upload-page-header-row h1 {
+  margin: 0 0 4px;
+}
+
+/* Back link */
+.upload-back-link {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 13px;
+  font-weight: 500;
+  color: var(--text);
+  text-decoration: none;
+  align-self: center;
+  flex-shrink: 0;
+  padding: 6px 10px;
+  border-radius: 7px;
+  transition:
+    background-color 0.12s,
+    color 0.12s;
+}
+
+.upload-back-link:hover {
+  background-color: var(--accent-bg);
+  color: var(--accent);
+}
+
+.upload-back-link:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+/* Upload card — centered, max-width, matching existing card aesthetics */
+.upload-card {
+  max-width: 480px;
+  width: 100%;
+  margin: 0 auto;
+  background: var(--bg);
+  border: 1px solid var(--border);
+  border-radius: 14px;
+  padding: 28px 28px 24px;
+  box-shadow: var(--shadow);
+}
+
+/* Card header: centered heading + muted subtitle */
+.upload-card-header {
+  text-align: center;
+  margin-bottom: 24px;
+}
+
+.upload-card-title {
+  font-family: var(--heading);
+  font-size: 18px;
+  font-weight: 600;
+  color: var(--text-h);
+  margin: 0 0 5px;
+  line-height: 1.3;
+}
+
+.upload-card-subtitle {
+  font-size: 13px;
+  color: var(--text);
+  margin: 0;
+  line-height: 1.5;
+}
+
+/* Hidden native file input — accessible to AT but visually hidden */
+.upload-input-hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  clip-path: inset(50%);
+  white-space: nowrap;
+  border: 0;
+}
+
+/* Form wrapper — relative positioning for hidden input */
+.upload-form {
+  position: relative;
+}
+
+/* Drop zone — large dashed bordered rectangle */
+.upload-dropzone {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  width: 100%;
+  min-height: 180px;
+  border: 2px dashed var(--border);
+  border-radius: 10px;
+  background: var(--code-bg);
+  cursor: pointer;
+  padding: 28px 20px;
+  box-sizing: border-box;
+  transition:
+    border-color 0.15s,
+    background-color 0.15s;
+  outline: none;
+}
+
+.upload-dropzone:hover {
+  border-color: var(--accent-border);
+  background: var(--accent-bg);
+}
+
+.upload-dropzone:focus-visible {
+  border-color: var(--accent);
+  box-shadow: 0 0 0 3px var(--accent-bg);
+}
+
+/* Drag-active state — when files are being dragged over the zone */
+.upload-dropzone--active {
+  border-color: var(--accent);
+  background: var(--accent-bg);
+}
+
+/* Upload cloud icon */
+.upload-cloud-icon {
+  color: var(--text);
+  opacity: 0.45;
+  margin-bottom: 12px;
+  flex-shrink: 0;
+  transition:
+    color 0.15s,
+    opacity 0.15s;
+}
+
+.upload-cloud-icon--active {
+  color: var(--accent);
+  opacity: 1;
+}
+
+.upload-dropzone:hover .upload-cloud-icon {
+  color: var(--accent);
+  opacity: 0.85;
+}
+
+/* Drop zone instruction text */
+.upload-dropzone-text {
+  font-size: 14px;
+  font-weight: 500;
+  color: var(--text-h);
+  margin: 0;
+  text-align: center;
+  line-height: 1.5;
+  pointer-events: none; /* let clicks pass through to the zone */
+}
+
+/* "Browse" inline action — styled with primary accent color */
+.upload-browse-action {
+  color: var(--accent);
+  font-weight: 600;
+  text-decoration: underline;
+  text-underline-offset: 2px;
+  transition: opacity 0.12s;
+}
