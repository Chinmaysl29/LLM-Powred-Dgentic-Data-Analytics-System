+  justify-content: flex-end;
+  width: 100%;
+  margin-top: -4px;
+}
+
+/* ---------------------------------------------------------------------------
+   Footer text + links
+   --------------------------------------------------------------------------- */
+
+.av2-footer {
+  margin-top: 28px;
+  text-align: center;
+  font-size: 14px;
+  color: var(--av2-text-muted);
