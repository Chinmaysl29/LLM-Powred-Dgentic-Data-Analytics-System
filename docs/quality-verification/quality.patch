+                key={`${index}-${label}`}
+                style={{ background: '#0e1111', borderRadius: 6, padding: 10 }}
+              >
+                <p
+                  style={{
+                    fontSize: 9,
+                    color: '#5A6A6A',
+                    textTransform: 'uppercase',
+                    letterSpacing: '0.1em',
+                    marginBottom: 4,
+                  }}
