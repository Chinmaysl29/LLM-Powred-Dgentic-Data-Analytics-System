+                  const r = matrix[row]?.[colKey] ?? 0;
+                  return (
+                    <td
+                      key={colKey}
+                      style={{
+                        background: corrColor(r),
+                        color: Math.abs(r) > 0.4 ? '#F4F5F0' : '#5A6A6A',
+                      }}
+                      title={`${row} × ${colKey}: ${r.toFixed(3)}`}
