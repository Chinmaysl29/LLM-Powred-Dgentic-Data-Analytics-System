+        <div className="cinematic-legal-links">
+          <Link to="/privacy">Privacy Policy</Link>
+          <Link to="/terms">Terms of Service</Link>
+          <Link to="/dashboard">System Status</Link>
+        </div>
+      </footer>
+    </div>
+  );
+}
