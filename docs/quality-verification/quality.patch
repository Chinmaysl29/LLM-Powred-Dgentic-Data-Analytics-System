+/* =========================================================================
+   Landing Page
+   Phase 3 — Frontend only. Uses existing design tokens plus landing-specific
+   values scoped under .landing-* namespace to prevent collisions.
+   ========================================================================= */
+
+/* -------------------------------------------------------------------------
+   1. Page Shell
+   ------------------------------------------------------------------------- */
+
+.landing-page {
+  min-height: 100svh;
+  /* Near-black cinematic base — Reference Image 2 */
+  background-color: #050505;
+  position: relative;
+  overflow-x: hidden;
+  display: flex;
+  flex-direction: column;
+}
+
+/* Skip-to-content link for keyboard users */
+.landing-skip-link {
+  position: absolute;
+  top: -100%;
+  left: 50%;
+  transform: translateX(-50%);
+  background: #0d0c10;
+  color: #fff;
+  font-size: 14px;
+  font-weight: 500;
+  padding: 8px 20px;
+  border-radius: 0 0 8px 8px;
+  text-decoration: none;
+  z-index: 9999;
+  transition: top 0.15s;
+}
+
+.landing-skip-link:focus {
+  top: 0;
+}
+
+/* =========================================================================
+   Background Layer System
+   Four composited layers that recreate the cinematic environment
+   from the reference image. All layers: position:absolute, pointer-events:none.
+   z-index stack: grid(0) → atmosphere(1) → glow(2) → sphere(3) → hero(5)
+   ========================================================================= */
+
+/* -------------------------------------------------------------------------
+   Layer 1: Architectural grid
+   Thin horizontal + vertical lines at low opacity, fading toward light.
+   ------------------------------------------------------------------------- */
+.lp-grid {
+  position: absolute;
+  inset: 0;
+  /*
+    Reference-matching grid:
+    - ~72px cells (medium architectural density — matches reference)
+    - Lines at 11% opacity: clearly visible but not distracting
+    - Monochromatic dark-gray (no color tint)
+    - Mask fades grid into brightening lower region so dome can shine through
+    - Extended mask stops at 92% so grid remains subtly detectable behind the
+      atmospheric glow — creating layered depth (grid → glow → horizon).
+  */
+  background-image:
+    linear-gradient(rgba(255, 255, 255, 0.11) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(255, 255, 255, 0.11) 1px, transparent 1px);
+  background-size: 72px 72px;
+  /* Extended fade — grid ghosted behind glow rather than fully removed */
+  mask-image: linear-gradient(
+    to bottom,
+    rgba(0, 0, 0, 1) 0%,
+    rgba(0, 0, 0, 1) 45%,
+    rgba(0, 0, 0, 0.55) 68%,
+    rgba(0, 0, 0, 0.18) 82%,
+    rgba(0, 0, 0, 0) 92%
+  );
+  -webkit-mask-image: linear-gradient(
+    to bottom,
+    rgba(0, 0, 0, 1) 0%,
+    rgba(0, 0, 0, 1) 45%,
+    rgba(0, 0, 0, 0.55) 68%,
+    rgba(0, 0, 0, 0.18) 82%,
+    rgba(0, 0, 0, 0) 92%
+  );
+  pointer-events: none;
+  z-index: 0;
+}
+
+/* -------------------------------------------------------------------------
+   Layer 2: Grayscale atmospheric gradient
+   Multiple radial + linear gradients creating smooth light build-up.
+   ------------------------------------------------------------------------- */
+.lp-atmosphere {
+  position: absolute;
+  inset: 0;
+  background:
+    /*
+      Refined atmosphere — layered top-to-bottom illumination.
+      Five layers to create smooth zone transitions:
+
+      A: Vast lower ellipse — primary light pool rising from the dome..
+         Extra-wide so edges bleed far out of frame.
+    */
+    radial-gradient(
+      ellipse 180% 90% at 50% 115%,
+      rgba(220, 220, 220, 0.26) 0%,
+      rgba(180, 180, 180, 0.1) 38%,
+      transparent 62%
+    ),
+    /* B: Mid-cone — the tighter hot-spot immediately above the rim */
+    radial-gradient(
+        ellipse 110% 65% at 50% 102%,
+        rgba(170, 170, 170, 0.22) 0%,
+        rgba(130, 130, 130, 0.09) 42%,
+        transparent 62%
+      ),
+    /* C: Near-dome hotspot — concentrated brightness at horizon */
+    radial-gradient(
+        ellipse 85% 50% at 50% 96%,
+        rgba(210, 210, 210, 0.2) 0%,
+        rgba(160, 160, 160, 0.06) 45%,
+        transparent 60%
+      ),
+    /* D: Vertical depth wash — creates Zone A→B gradient from dark top to warm base */
+    linear-gradient(
+        to bottom,
+        transparent 0%,
+        transparent 28%,
+        rgba(30, 30, 30, 0.08) 52%,
+        rgba(55, 55, 55, 0.2) 72%,
+        rgba(30, 30, 30, 0.28) 100%
+      ),
+    /* E: Very faint upper central column — ties glow to hero heading zone */
+    radial-gradient(ellipse 55% 40% at 50% 60%, rgba(255, 255, 255, 0.015) 0%, transparent 80%);
+  pointer-events: none;
+  z-index: 1;
+}
+
+/* -------------------------------------------------------------------------
+   Layer 3: Central volumetric glow
+   Very broad, extremely low-opacity soft white glow centered above ellipse.
+   Creates the "light diffusing through fog" appearance.
+   ------------------------------------------------------------------------- */
+.lp-glow {
+  position: absolute;
+  inset: 0;
+  /*
+    Refined atmospheric volumetric glow.
+
+    Five graduated layers that create distinct depth zones:
+      Zone A (upper hero) — almost black, grid visible
+      Zone B (mid hero)   — very soft atmospheric gray/white wash
+      Zone C (horizon)    — concentrated bright glow above curve rim
+
+    The glow reaches significantly higher into the hero so the
+    content floats in a haze rather than sitting on a blank background.
+  */
+  background:
+    /* A — extremely vast outer aura; the farthest, most diffused envelope */
+    radial-gradient(
+      ellipse 160% 80% at 50% 86%,
+      rgba(255, 255, 255, 0.07) 0%,
+      rgba(255, 255, 255, 0.032) 38%,
+      rgba(255, 255, 255, 0.008) 62%,
+      transparent 78%
+    ),
+    /* B — broad mid-spread: primary atmospheric illumination band */
+    radial-gradient(
+        ellipse 115% 62% at 50% 91%,
+        rgba(255, 255, 255, 0.13) 0%,
+        rgba(255, 255, 255, 0.06) 36%,
+        rgba(255, 255, 255, 0.014) 62%,
+        transparent 78%
+      ),
+    /* C — medium inner cone: Zone B→C bright transition */
+    radial-gradient(
+        ellipse 80% 48% at 50% 94%,
+        rgba(255, 255, 255, 0.18) 0%,
+        rgba(255, 255, 255, 0.09) 30%,
+        rgba(255, 255, 255, 0.022) 58%,
+        transparent 72%
+      ),
+    /* D — Zone C hot zone: tightest, brightest, immediately above rim */
+    radial-gradient(
+        ellipse 60% 30% at 50% 97%,
+        rgba(255, 255, 255, 0.15) 0%,
+        rgba(255, 255, 255, 0.075) 28%,
+        rgba(255, 255, 255, 0.018) 55%,
+        transparent 68%
+      ),
+    /* E — faint central column rising into the hero body (Zone A→B connector) */
+    radial-gradient(
+        ellipse 45% 72% at 50% 68%,
+        rgba(255, 255, 255, 0.028) 0%,
+        rgba(255, 255, 255, 0.01) 45%,
+        transparent 70%
+      );
+  pointer-events: none;
+  z-index: 2;
+}
+
+/* -------------------------------------------------------------------------
+   Layer 4: Giant glowing dark ellipse
+   The primary visual spectacle. A massive CSS border-radius ellipse with
+   multi-layer box-shadow creating the bright white rim + bloom effect.
+   Sits BEHIND hero content (z-index: 3 < hero's z-index: 5).
+   Wide enough to bleed past both viewport edges.
+   ------------------------------------------------------------------------- */
+.lp-sphere {
+  position: absolute;
+  /*
+    Sphere positioning — rim appears at ~74-78% from top of viewport.
+    All hero content (badge, heading, subheading, CTA) sits comfortably
+    above the rim with generous breathing room.
+
+    Calculation: rim_top_from_bottom = height - |bottom| = 82vh - 56vh = 26vh
+    → rim is at 100vh - 26vh = 74% from the top of the viewport.
+    The CTA button at ~60-65% from top has ~9-14% gap above the rim.
+  */
+  bottom: -56vh;
+  left: 50%;
+  transform: translateX(-50%);
+  /*
+    Width: extremely wide (180vw) so the curve is flattened into a
+    near-flat horizon — the center rises only ~2-3° above the edges,
+    matching the "distant planet edge" aesthetic rather than a visible oval.
+  */
+  width: 180vw;
+  max-width: 3200px;
+  /*
+    Height: generous so the arc is broad and the rim isn't overly curved.
+    Taller sphere = flatter visible arc.
+  */
+  height: 82vh;
+  min-height: 480px;
+  border-radius: 50%;
+  /*
+    Dark interior — near the rim a subtle lighter edge catches the glow;
+    deepens to pure black inside. Creates the "deep surface" below the horizon.
+  */
+  background: radial-gradient(
+    ellipse 100% 18% at 50% 0%,
+    #1a1a1a 0%,
+    #0c0c0c 10%,
+    #060606 28%,
+    #020202 55%,
+    #010101 100%
+  );
+  /*
+    Seven-layer box-shadow for the refined rim:
+
+    Layer 1 — hair-thin crisp luminous line (the polished rim edge)
+    Layer 2 — immediate tight bloom (1-4px above rim)
+    Layer 3 — close halo (4-16px above rim)
+    Layer 4 — medium glow envelope (16-50px)
+    Layer 5 — large atmospheric bloom (50-140px)
+    Layer 6 — vast outer atmospheric wash (140-320px)
+    Layer 7 — horizon atmospheric tail (320-600px)
+
+    This produces the sharp-edge-then-soft-bloom hierarchy.
+  */
+  box-shadow:
+    0 0px 0px 1px rgba(255, 255, 255, 0.98),
+    0 -2px 6px 0px rgba(255, 255, 255, 0.82),
+    0 -6px 18px 0px rgba(255, 255, 255, 0.52),
+    0 -16px 50px 0px rgba(255, 255, 255, 0.28),
+    0 -45px 140px 0px rgba(255, 255, 255, 0.14),
+    0 -100px 320px 0px rgba(255, 255, 255, 0.07),
+    0 -200px 600px 0px rgba(255, 255, 255, 0.03);
+  pointer-events: none;
+  z-index: 3;
+}
+
+/*
+  lp-sphere::after — hair-thin crisp white ring on top of the box-shadow bloom.
+
+  The box-shadow approach has a physical limit: spread/blur slightly
+  rounds the very apex of the rim. The ::after pseudo-element adds a
+  dedicated opaque ring inset 1px from the outer edge that reads as a
+  laser-precise luminous line without affecting the soft glow cascade above.
+
+  It sits at z-index 4 (just above the sphere surface) and is masked
+  to only the top 15% of the circle so it doesn't bleed downward.
+*/
+.lp-sphere::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  border-radius: 50%;
+  /*
+    Radial gradient that creates a pure bright ring only at the very top
+    of the ellipse — falls off to transparent within the first 6%.
+    This complements the box-shadow rim without doubling the glow.
+  */
+  background: radial-gradient(
+    ellipse 100% 8% at 50% 0%,
+    rgba(255, 255, 255, 0.3) 0%,
+    rgba(255, 255, 255, 0.1) 45%,
+    transparent 100%
+  );
+  pointer-events: none;
+}
+
+/* -------------------------------------------------------------------------
+   2. Navbar Wrapper — entrance animation
+   ------------------------------------------------------------------------- */
+
+.landing-nav-wrapper {
+  position: fixed;
+  top: 20px;
+  left: 0;
+  right: 0;
+  z-index: 1000;
+  display: flex;
+  justify-content: center;
+  padding: 0 20px;
+  opacity: 0;
+  transform: translateY(-10px);
+  pointer-events: none;
+}
+
+.landing-nav-wrapper--visible {
+  animation: lp-nav-enter 400ms cubic-bezier(0.25, 0.46, 0.45, 0.94) 0ms forwards;
+  pointer-events: auto;
+}
+
+@keyframes lp-nav-enter {
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+/* -------------------------------------------------------------------------
+   3. Pill Navbar
+   ------------------------------------------------------------------------- */
+
+.landing-nav {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  padding: 7px 8px 7px 12px;
+  background: rgba(20, 20, 20, 0.75);
+  border: 1px solid rgba(255, 255, 255, 0.12);
+  border-radius: 9999px;
+  box-shadow:
+    0 2px 8px rgba(0, 0, 0, 0.4),
+    0 0 0 0.5px rgba(255, 255, 255, 0.06) inset;
+  backdrop-filter: blur(20px) saturate(1.4);
+  -webkit-backdrop-filter: blur(20px) saturate(1.4);
+  width: 100%;
+  max-width: 560px;
+  transition:
+    box-shadow 0.25s ease,
+    background 0.25s ease;
+}
+
+.landing-nav--scrolled {
+  background: rgba(15, 15, 15, 0.92);
+  box-shadow:
+    0 4px 20px rgba(0, 0, 0, 0.5),
+    0 0 0 0.5px rgba(255, 255, 255, 0.08) inset;
+}
+
+/* -------------------------------------------------------------------------
+   4. Brand / Logo
+   ------------------------------------------------------------------------- */
+
+.landing-nav-brand {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  text-decoration: none;
+  color: #ffffff;
+  flex-shrink: 0;
+  padding: 4px 8px 4px 2px;
+  border-radius: 9999px;
+  transition: opacity 0.15s;
+}
+
+.landing-nav-brand:hover {
+  opacity: 0.75;
+}
+
+.landing-nav-brand:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 3px;
+  border-radius: 9999px;
+}
+
+.landing-nav-brand-dot {
+  width: 22px;
+  height: 22px;
+  border-radius: 50%;
+  background: linear-gradient(135deg, #ffffff 0%, #aaaaaa 100%);
+  flex-shrink: 0;
+  box-shadow: 0 1px 4px rgba(255, 255, 255, 0.2);
+}
+
+.landing-nav-brand-text {
+  font-family: var(--heading);
+  font-size: 13px;
+  font-weight: 600;
+  letter-spacing: -0.2px;
+  white-space: nowrap;
+  color: #ffffff;
+}
+
+/* -------------------------------------------------------------------------
+   5. Center Nav Links + Sliding Indicator
+   ------------------------------------------------------------------------- */
+
+.landing-nav-center {
+  display: flex;
+  align-items: center;
+  gap: 0;
+  flex: 1;
+  justify-content: center;
+  position: relative;
+}
+
+/* Indicator pill — driven entirely by inline transform from JS.
+   JS sets: transform: translateX(Xpx) translateY(-50%) — combining
+   horizontal position and vertical centering in one string to avoid
+   CSS transform cascade conflicts. */
+.landing-nav-indicator {
+  position: absolute;
+  top: 50%;
+  left: 0;
+  height: 30px;
+  border-radius: 9999px;
+  background: rgba(255, 255, 255, 0.12);
+  pointer-events: none;
+  will-change: transform, width;
+}
+
+.landing-nav-link,
+.landing-nav-link--btn {
+  position: relative;
+  z-index: 1;
+  font-family: var(--sans);
+  font-size: 13.5px;
+  font-weight: 500;
+  color: rgba(255, 255, 255, 0.6);
+  text-decoration: none;
+  padding: 5px 14px;
+  border-radius: 9999px;
+  border: none;
+  background: none;
+  cursor: pointer;
+  line-height: 1;
+  white-space: nowrap;
+  transition: color 0.15s;
+  display: inline-flex;
+  align-items: center;
+}
+
+.landing-nav-link:hover,
+.landing-nav-link--btn:hover,
+.landing-nav-link:focus-visible,
+.landing-nav-link--btn:focus-visible {
+  color: rgba(255, 255, 255, 0.95);
+}
+
+.landing-nav-link:focus-visible,
+.landing-nav-link--btn:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+  border-radius: 9999px;
+}
+
+/* -------------------------------------------------------------------------
+   6. Right action buttons
+   ------------------------------------------------------------------------- */
+
+.landing-nav-actions {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  flex-shrink: 0;
+}
+
+.landing-nav-login {
+  font-family: var(--sans);
+  font-size: 13.5px;
+  font-weight: 500;
+  color: rgba(255, 255, 255, 0.65);
+  text-decoration: none;
+  padding: 6px 14px;
+  border-radius: 9999px;
+  transition:
+    color 0.15s,
+    background 0.15s;
+}
+
+.landing-nav-login:hover {
+  color: #ffffff;
+  background: rgba(255, 255, 255, 0.08);
+}
+
+.landing-nav-login:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+  border-radius: 9999px;
+}
+
+.landing-nav-signup {
+  font-family: var(--sans);
+  font-size: 13.5px;
+  font-weight: 600;
+  color: #0d0c10;
+  text-decoration: none;
+  background: #ffffff;
+  padding: 7px 16px;
+  border-radius: 9999px;
+  transition:
+    opacity 0.15s,
+    transform 0.15s,
+    box-shadow 0.15s;
+  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
+  white-space: nowrap;
+}
+
+.landing-nav-signup:hover {
+  opacity: 0.85;
+  transform: translateY(-1px);
+  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.35);
+}
+
+.landing-nav-signup:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+  border-radius: 9999px;
+}
+
+/* -------------------------------------------------------------------------
+   7. Mobile hamburger button (hidden on desktop)
+   ------------------------------------------------------------------------- */
+
+.landing-nav-hamburger {
+  display: none;
+  background: none;
+  border: none;
+  padding: 8px;
+  cursor: pointer;
+  border-radius: 8px;
+  flex-shrink: 0;
+  transition: background 0.15s;
+}
+
+.landing-nav-hamburger:hover {
+  background: rgba(0, 0, 0, 0.06);
+}
+
+.landing-nav-hamburger:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+.landing-hamburger-icon {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  width: 20px;
+}
+
+.landing-hamburger-icon span {
+  display: block;
+  height: 1.5px;
+  background: #ffffff;
+  border-radius: 2px;
+  transition:
+    transform 0.2s,
+    opacity 0.2s;
+  transform-origin: center;
+}
+
+.landing-hamburger-icon--open span:nth-child(1) {
+  transform: translateY(5.5px) rotate(45deg);
+}
+
+.landing-hamburger-icon--open span:nth-child(2) {
+  opacity: 0;
+  transform: scaleX(0);
+}
+
+.landing-hamburger-icon--open span:nth-child(3) {
+  transform: translateY(-5.5px) rotate(-45deg);
+}
+
+/* -------------------------------------------------------------------------
+   8. Mobile Drawer
+   ------------------------------------------------------------------------- */
+
+.landing-mobile-overlay {
+  position: fixed;
+  inset: 0;
+  background: rgba(0, 0, 0, 0.15);
+  z-index: 900;
+  animation: lp-fade-in 200ms ease forwards;
+}
+
+.landing-mobile-drawer {
+  position: fixed;
+  top: 80px;
+  left: 50%;
+  transform: translateX(-50%) translateY(-10px);
+  width: calc(100% - 40px);
+  max-width: 400px;
+  background: rgba(20, 20, 20, 0.96);
+  backdrop-filter: blur(24px) saturate(1.4);
+  -webkit-backdrop-filter: blur(24px) saturate(1.4);
+  border: 1px solid rgba(255, 255, 255, 0.1);
+  border-radius: 20px;
+  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
+  z-index: 1000;
+  opacity: 0;
+  pointer-events: none;
+  transition:
+    transform 250ms cubic-bezier(0.34, 1.15, 0.64, 1),
+    opacity 200ms ease;
+}
+
+.landing-mobile-drawer--open {
+  opacity: 1;
+  transform: translateX(-50%) translateY(0);
+  pointer-events: auto;
+}
+
+.landing-mobile-nav {
+  list-style: none;
+  margin: 0;
+  padding: 12px;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+
+.landing-mobile-link {
+  display: block;
+  font-family: var(--sans);
+  font-size: 15px;
+  font-weight: 500;
+  color: #ffffff;
+  text-decoration: none;
+  background: none;
+  border: none;
+  cursor: pointer;
+  padding: 10px 16px;
+  border-radius: 12px;
+  width: 100%;
+  text-align: left;
+  transition: background 0.15s;
+}
+
+.landing-mobile-link:hover {
+  background: rgba(255, 255, 255, 0.08);
+}
+
+.landing-mobile-link:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+.landing-mobile-link--signup {
+  background: #ffffff;
+  color: #0d0c10;
+  text-align: center;
+  margin-top: 4px;
+  border-radius: 12px;
+}
+
+.landing-mobile-link--signup:hover {
+  background: rgba(255, 255, 255, 0.88);
+}
+
+.landing-mobile-divider {
+  height: 1px;
+  background: rgba(255, 255, 255, 0.1);
+  margin: 6px 4px;
+  list-style: none;
+}
+
+/* -------------------------------------------------------------------------
+   9. Hero Section
+   ------------------------------------------------------------------------- */
+
+.landing-hero {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  /*
+    Reference composition analysis:
+    - Large negative space between navbar and badge (badge sits ~28% from top)
+    - Heading centered in upper 2/3 of hero
+    - CTA sits just above the bright dome rim
+    - Increased top padding to push content above the dome properly
+  */
+  justify-content: flex-start;
+  text-align: center;
+  flex: 1;
+  padding: 170px 24px 100px;
+  position: relative;
+  /* Must be above all background layers (grid=0, atmo=1, glow=2, sphere=3) */
+  z-index: 5;
+  outline: none;
+}
+
+/* Eyebrow badge — dark glass futuristic pill */
+.landing-eyebrow {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  font-family: var(--sans);
+  font-size: 11px;
+  font-weight: 500;
+  letter-spacing: 1.1px;
+  text-transform: uppercase;
+  color: rgba(255, 255, 255, 0.42);
+  background: rgba(22, 22, 22, 0.78);
+  border: 1px solid rgba(255, 255, 255, 0.09);
+  padding: 6px 16px 6px 12px;
+  border-radius: 9999px;
+  margin-bottom: 28px;
+  backdrop-filter: blur(12px);
+  -webkit-backdrop-filter: blur(12px);
+}
+
+.landing-eyebrow-dot {
+  width: 5px;
+  height: 5px;
+  border-radius: 50%;
+  /* Retain tiny accent dot — only colorful element, very small */
+  background: var(--accent);
+  opacity: 0.7;
+  flex-shrink: 0;
+}
+
+/* Main heading — cinematic oversized typography */
+.landing-heading {
+  font-family: var(--heading);
+  /* Responsive: 52px mobile → 84px desktop */
+  font-size: clamp(52px, 6.5vw, 84px);
+  font-weight: 700;
+  /* Tight cinematic line-height */
+  line-height: 1.02;
+  letter-spacing: -3.5px;
+  /* Softened white — slightly warmer than pure #fff */
+  color: #f5f5f5;
+  margin: 0 0 22px;
+  max-width: 1000px;
+}
+
+/* "Decisions" accent word — same color as rest of heading, no colored underline */
+.landing-heading-accent {
+  color: #f5f5f5;
+  position: relative;
+  display: inline-block;
+}
+
+/* Remove colored underline — monochromatic reference design */
+.landing-heading-accent::after {
+  display: none;
+}
+
+/* Subheading — muted gray, controlled width, relaxed line-height */
+.landing-subheading {
+  font-family: var(--sans);
+  font-size: clamp(15px, 1.7vw, 17px);
+  font-weight: 400;
+  line-height: 1.68;
+  /* Muted gray — not pure white, matches reference's subdued treatment */
+  color: #9a9a9a;
+  max-width: 580px;
+  margin: 0 0 40px;
+  letter-spacing: 0.05px;
+}
+
+/* CTA row */
+.landing-cta-row {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+
+/* Primary CTA button — premium white pill with soft neutral glow */
+.landing-cta-primary {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  font-family: var(--sans);
+  font-size: 14px;
+  font-weight: 600;
+  color: #090909;
+  text-decoration: none;
+  background: #f2f2f2;
+  border: none;
+  padding: 13px 32px;
+  border-radius: 9999px;
+  cursor: pointer;
+  box-shadow:
+    0 8px 30px rgba(255, 255, 255, 0.1),
+    0 12px 40px rgba(0, 0, 0, 0.3);
+  transition:
+    opacity 0.15s,
+    transform 0.18s cubic-bezier(0.34, 1.2, 0.64, 1),
+    box-shadow 0.18s ease;
+  letter-spacing: 0.1px;
+}
+
+.landing-cta-primary:hover {
+  opacity: 0.95;
+  transform: translateY(-1px);
+  box-shadow:
+    0 12px 40px rgba(255, 255, 255, 0.16),
+    0 20px 50px rgba(0, 0, 0, 0.35);
+}
+
+.landing-cta-primary:active {
+  transform: translateY(0);
+}
+
+.landing-cta-primary:focus-visible {
+  outline: 2px solid rgba(255, 255, 255, 0.5);
+  outline-offset: 3px;
+}
+
+/* -------------------------------------------------------------------------
+   10. Entrance Animations — staggered fade-up
+   ------------------------------------------------------------------------- */
+
+.landing-anim {
+  opacity: 0;
+  animation: lp-fade-up 520ms cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
+}
+
+.landing-anim--0 {
+  animation-delay: 120ms;
+}
+.landing-anim--1 {
+  animation-delay: 210ms;
+}
+.landing-anim--2 {
+  animation-delay: 340ms;
+}
+.landing-anim--3 {
+  animation-delay: 460ms;
+}
+
+@keyframes lp-fade-up {
+  from {
+    opacity: 0;
+    transform: translateY(18px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+@keyframes lp-fade-in {
+  from {
+    opacity: 0;
+  }
+  to {
+    opacity: 1;
+  }
+}
+
+/* -------------------------------------------------------------------------
+   11. Reduced Motion Overrides
+   ------------------------------------------------------------------------- */
+
+@media (prefers-reduced-motion: reduce) {
+  .landing-nav-wrapper {
+    opacity: 1;
+    transform: none;
+    animation: none;
+    pointer-events: auto;
+  }
+
+  .landing-nav-wrapper--visible {
+    animation: none;
+    opacity: 1;
+    transform: none;
+  }
+
+  .landing-anim {
+    animation: none;
+    opacity: 1;
+    transform: none;
+  }
+
+  .landing-nav-indicator {
+    transition: none !important;
+  }
+
+  .landing-cta-primary,
+  .landing-nav-signup {
+    transition: opacity 0.15s;
+  }
+
+  .landing-cta-primary:hover,
+  .landing-nav-signup:hover {
+    transform: none;
+  }
+
+  .landing-mobile-drawer {
+    transition: opacity 200ms ease;
+    transform: translateX(-50%) !important;
+  }
+
+  .landing-mobile-drawer--open {
+    transform: translateX(-50%) !important;
+  }
+
+  .landing-hamburger-icon span {
+    transition: none;
+  }
+}
+
+/* -------------------------------------------------------------------------
+   12. Responsive — Tablet (≤900px)
+   ------------------------------------------------------------------------- */
+
+@media (max-width: 900px) {
+  .landing-nav {
+    max-width: 480px;
+    padding: 7px 8px 7px 10px;
+  }
+
+  .landing-nav-brand-text {
+    font-size: 12px;
+  }
+
+  /* Horizon responsive — tablet:
+     Widen slightly more to compensate for narrower vw units,
+     and re-anchor bottom so rim stays at ~74-78% viewport height.
+     rim = height - |bottom| = 72vh - 50vh = 22vh from bottom = 78% from top */
+  .lp-sphere {
+    width: 220vw;
+    height: 72vh;
+    min-height: 440px;
+    bottom: -50vh;
+  }
+}
+
+/* -------------------------------------------------------------------------
+   13. Responsive — Mobile (≤680px): collapse nav links, show hamburger
+   ------------------------------------------------------------------------- */
+
+@media (max-width: 680px) {
+  .landing-nav-center,
+  .landing-nav-actions {
+    display: none;
+  }
+
+  .landing-nav-hamburger {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    margin-left: auto;
+  }
+
+  .landing-nav {
+    max-width: 100%;
+    padding: 8px 10px;
+    gap: 0;
+  }
+
+  .landing-nav-wrapper {
+    top: 14px;
+    padding: 0 14px;
+  }
+
+  .landing-hero {
+    padding: 168px 20px 80px;
+  }
+
+  .landing-heading {
+    letter-spacing: -2px;
+    font-size: clamp(40px, 8vw, 64px);
+  }
+
+  /* Horizon responsive — mobile landscape:
+     Extra-wide vw compensates for reduced pixel density in vw units.
+     rim = height - |bottom| = 68vh - 46vh = 22vh from bottom = 78% from top */
+  .lp-sphere {
+    width: 280vw;
+    height: 68vh;
+    min-height: 400px;
+    bottom: -46vh;
+  }
+}
+
+/* -------------------------------------------------------------------------
+   14. Responsive — Small Mobile (≤480px)
+   ------------------------------------------------------------------------- */
+
+@media (max-width: 480px) {
+  .landing-hero {
+    padding: 155px 16px 70px;
+  }
+
+  .landing-eyebrow {
+    font-size: 11px;
+    margin-bottom: 28px;
+  }
+
+  .landing-subheading {
+    font-size: 15px;
+    line-height: 1.65;
+  }
+
+  .landing-cta-primary {
+    font-size: 13.5px;
+    padding: 11px 26px;
+  }
+
+  /* Horizon responsive — small mobile (375–480px):
+     Extremely wide vw so the curve is still clearly a horizon, not an oval.
+     rim = height - |bottom| = 62vh - 42vh = 20vh from bottom = 80% from top */
+  .lp-sphere {
+    width: 340vw;
+    height: 62vh;
+    min-height: 360px;
+    bottom: -42vh;
+  }
+}
+
+/* =========================================================================
+   Features Section
+   Palette: CHARCOAL #4D4D4D | TAUPE #A89D92 | IVORY #F8F4EE | WHITE #FFFFFF
+   Uses CSS custom properties injected per-card from FeaturesSection.tsx:
+     --feat-bg           resting card background
+     --feat-text         resting card text color
+     --feat-curtain-bg   revealed (curtain) background
+     --feat-curtain-text revealed text color
+     --feat-border       subtle card border
+     --feat-delay        stagger animation delay
+   ========================================================================= */
+
+/* -------------------------------------------------------------------------
+   Section shell — sits below the hero, scrolls naturally into view
+   ------------------------------------------------------------------------- */
+
+.features-section {
+  position: relative;
+  z-index: 5;
+  /* Generous vertical breathing room — section starts below the hero dome */
+  padding: 120px 24px 140px;
+  /* Fade-up entrance — driven by IntersectionObserver via JS class toggle */
+  opacity: 0;
+  transform: translateY(32px);
+  transition:
+    opacity 640ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
+    transform 640ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
+}
+
+.features-section--visible {
+  opacity: 1;
+  transform: translateY(0);
+}
+
+/* -------------------------------------------------------------------------
+   Section header (eyebrow + heading)
+   ------------------------------------------------------------------------- */
+
+.features-header {
+  text-align: center;
+  margin-bottom: 64px;
+}
+
+.features-eyebrow {
+  display: inline-block;
+  font-family: var(--sans);
+  font-size: 11px;
+  font-weight: 500;
+  letter-spacing: 1.4px;
+  text-transform: uppercase;
+  color: rgba(255, 255, 255, 0.38);
+  margin-bottom: 16px;
+  margin-top: 0;
+}
+
+.features-heading {
+  font-family: var(--heading);
+  font-size: clamp(28px, 3.2vw, 44px);
+  font-weight: 600;
+  line-height: 1.12;
+  letter-spacing: -1.4px;
+  color: #f5f5f5;
+  margin: 0;
+}
+
+/* -------------------------------------------------------------------------
+   Card grid — 2×2 on desktop, 1-column on mobile
+   ------------------------------------------------------------------------- */
+
+.features-grid {
+  display: grid;
+  grid-template-columns: repeat(2, 1fr);
+  gap: 1px;
+  max-width: 960px;
+  margin: 0 auto;
+  /* Thin outer border rendered by the gap — matches the 1px grid line aesthetic */
+  background: rgba(255, 255, 255, 0.1);
+  border: 1px solid rgba(255, 255, 255, 0.1);
+  border-radius: 20px;
+  overflow: hidden;
+}
+
+/* =========================================================================
+   Feature Card — CardCurtainReveal root (.feat-card)
+   Each card uses CSS custom properties for its unique color scheme.
+   ========================================================================= */
+
+.feat-card {
+  position: relative;
+  overflow: hidden;
+  /* Color from per-card CSS var */
+  background-color: var(--feat-bg, #4d4d4d);
+  color: var(--feat-text, #f5f5f5);
+  border: 1px solid var(--feat-border, rgba(255, 255, 255, 0.1));
+  /* Comfortable card height — matches reference proportions */
+  min-height: 280px;
+  padding: 40px 36px 36px;
+  display: flex;
+  flex-direction: column;
+  justify-content: flex-end;
+  cursor: default;
+  outline: none;
+  /* Stagger entrance via per-card --feat-delay var */
+  animation: feat-card-enter 500ms cubic-bezier(0.25, 0.46, 0.45, 0.94) var(--feat-delay, 0ms) both;
+  transition: box-shadow 0.3s ease;
+}
+
+/* Card hover: very subtle lift — the curtain is the main interaction */
+.feat-card:hover {
+  box-shadow: 0 0 0 1.5px rgba(255, 255, 255, 0.18) inset;
+}
+
+.feat-card:focus-visible {
+  outline: 2px solid rgba(255, 255, 255, 0.5);
+  outline-offset: -3px;
+}
+
+@keyframes feat-card-enter {
+  from {
+    opacity: 0;
+    transform: translateY(20px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+/* -------------------------------------------------------------------------
+   Body — the always-visible resting-state content layer
+   ------------------------------------------------------------------------- */
+
+.feat-body {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  /* Sits below the curtain z-stack */
+  position: relative;
+  z-index: 1;
+}
+
+/* -------------------------------------------------------------------------
+   Title (.feat-title)
+   Two variants: --resting (always mounted) and --revealed (inside curtain)
+   ------------------------------------------------------------------------- */
+
+.feat-title {
+  font-family: var(--heading);
+  font-size: clamp(20px, 2vw, 26px);
+  font-weight: 600;
+  line-height: 1.15;
+  letter-spacing: -0.6px;
+  color: inherit;
+  margin: 0;
+  display: flex;
+  flex-direction: column;
+}
+
+/* Resting title — rendered in the body layer */
+.feat-title--resting {
+  /* animated by motion.h3 in JS — opacity/y driven by isOpen state */
+}
+
+/* Revealed title — rendered inside the curtain overlay */
+.feat-title--revealed {
+  /* animated by motion.h3 in JS — y driven by isOpen state (slides up) */
+  overflow: hidden;
+}
+
+/* Line wrapper — preserves newline splits from JS .split('\n') */
+.feat-title-line {
+  display: block;
+}
+
+/* -------------------------------------------------------------------------
+   Resting-state headline (short tagline beneath title)
+   ------------------------------------------------------------------------- */
+
+.feat-headline {
+  font-family: var(--sans);
+  font-size: 13px;
+  font-weight: 400;
+  line-height: 1.5;
+  color: inherit;
+  opacity: 0.55;
+  margin: 0;
+  max-width: 32ch;
+}
+
+/* =========================================================================
+   Curtain overlay (.feat-curtain)
+   Absolutely covers the card; clip-path animated by motion.div in JS.
+   ========================================================================= */
+
+.feat-curtain {
+  position: absolute;
+  inset: 0;
+  background-color: var(--feat-curtain-bg, #f8f4ee);
+  color: var(--feat-curtain-text, #1a1a1a);
+  padding: 40px 36px 36px;
+  display: flex;
+  flex-direction: column;
+  justify-content: flex-end;
+  gap: 12px;
+  z-index: 2;
+  /* Prevent curtain from intercepting events when hidden */
+  pointer-events: none;
+}
+
+/* When the curtain is animating open, re-enable pointer events */
+.feat-card:hover .feat-curtain,
+.feat-card:focus .feat-curtain,
+.feat-card:focus-within .feat-curtain {
+  pointer-events: auto;
+}
+
+/* -------------------------------------------------------------------------
+   Description — inside curtain
+   ------------------------------------------------------------------------- */
+
+.feat-desc {
+  font-family: var(--sans);
+  font-size: 14px;
+  font-weight: 400;
+  line-height: 1.65;
+  color: inherit;
+  opacity: 0.82;
+  margin: 0;
+  max-width: 38ch;
+  /* animated by motion.p in JS */
+}
+
+/* -------------------------------------------------------------------------
+   Footer — inside curtain
+   ------------------------------------------------------------------------- */
+
+.feat-footer {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-top: auto;
+  padding-top: 16px;
+  border-top: 1px solid rgba(0, 0, 0, 0.12);
+  /* animated by motion.div in JS */
+}
+
+/* "Learn more" label */
+.feat-footer-label {
+  font-family: var(--sans);
+  font-size: 12px;
+  font-weight: 500;
+  letter-spacing: 0.4px;
+  text-transform: uppercase;
+  color: inherit;
+  opacity: 0.55;
+}
+
+/* Arrow button */
+.feat-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 28px;
+  height: 28px;
+  border-radius: 50%;
+  border: 1px solid currentColor;
+  background: none;
+  cursor: pointer;
+  padding: 0;
+  opacity: 0.7;
+  transition:
+    opacity 0.15s,
+    transform 0.15s;
+}
+
+.feat-btn:hover {
+  opacity: 1;
+  transform: translate(1px, -1px);
+}
+
+.feat-btn:focus-visible {
+  outline: 2px solid currentColor;
+  outline-offset: 2px;
+}
+
+/* =========================================================================
+   Responsive Overrides — Features Section
+   ========================================================================= */
+
+/* -------------------------------------------------------------------------
+   Tablet (≤ 860px) — stack into single column
+   ------------------------------------------------------------------------- */
+
+@media (max-width: 860px) {
+  .features-section {
+    padding: 80px 20px 100px;
+  }
+
+  .features-grid {
+    grid-template-columns: 1fr;
+    border-radius: 16px;
+  }
+
+  .features-heading {
+    font-size: clamp(24px, 5vw, 36px);
+    letter-spacing: -1px;
+  }
+
+  .features-header {
+    margin-bottom: 44px;
+  }
+}
+
+/* -------------------------------------------------------------------------
+   Mobile (≤ 480px)
+   ------------------------------------------------------------------------- */
+
+@media (max-width: 480px) {
+  .features-section {
+    padding: 64px 16px 80px;
+  }
+
+  .feat-card {
+    min-height: 220px;
+    padding: 32px 24px 28px;
+  }
+
+  .feat-curtain {
+    padding: 32px 24px 28px;
+  }
+
+  .feat-title {
+    font-size: 20px;
+  }
+
+  .features-heading {
+    font-size: 24px;
+    letter-spacing: -0.8px;
+  }
+
+  .features-header {
+    margin-bottom: 32px;
+  }
+}
+
+/* -------------------------------------------------------------------------
+   Reduced-motion overrides — Features Section
+   ------------------------------------------------------------------------- */
+
+@media (prefers-reduced-motion: reduce) {
+  .features-section {
+    opacity: 1;
+    transform: none;
+    transition: none;
+  }
+
+  .feat-card {
+    animation: none;
+  }
+}
+
+/* =========================================================================
+   Auth v2 — Dark Premium UI
+   All classes prefixed `av2-` to avoid conflicts with existing auth-* / form-*
+   styles used elsewhere in the app.
+   ========================================================================= */
+
+/* ---------------------------------------------------------------------------
+   CSS custom properties scoped to .av2-layout so they don't bleed
+   into the rest of the app (which uses light/dark via prefers-color-scheme).
+   --------------------------------------------------------------------------- */
+
+.av2-layout {
+  --av2-bg: #000;
+  --av2-surface: rgba(255, 255, 255, 0.04);
+  --av2-surface-hov: rgba(255, 255, 255, 0.08);
+  --av2-border: rgba(255, 255, 255, 0.1);
+  --av2-border-hov: rgba(255, 255, 255, 0.2);
+  --av2-text: #fff;
+  --av2-text-muted: rgba(255, 255, 255, 0.45);
+  --av2-text-sub: rgba(255, 255, 255, 0.6);
+  --av2-glow: rgba(255, 255, 255, 0.06);
+  --av2-error: rgba(248, 113, 113, 0.9);
+  --av2-error-bg: rgba(248, 113, 113, 0.1);
+  --av2-error-border: rgba(248, 113, 113, 0.25);
+  --av2-radius-pill: 9999px;
+  --av2-radius-card: 16px;
+  --av2-transition: 200ms cubic-bezier(0.22, 1, 0.36, 1);
+}
+
+/* ---------------------------------------------------------------------------
+   Root auth layout — full-screen dark with dotted grid + atmospheric layers
+   --------------------------------------------------------------------------- */
+
+.av2-layout {
+  position: relative;
+  min-height: 100svh;
+  background-color: var(--av2-bg);
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  overflow: hidden;
+  color: var(--av2-text);
+  font-family: var(--sans);
+  /* Prevent flash of white on navigation */
+  isolation: isolate;
+}
+
+/* Dotted grid texture */
+.av2-layout::before {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background-image: radial-gradient(circle, rgba(255, 255, 255, 0.12) 1px, transparent 1px);
+  background-size: 28px 28px;
+  pointer-events: none;
+  z-index: 0;
+}
+
+/* Atmospheric radial glow — top-center */
+.av2-layout::after {
+  content: '';
+  position: absolute;
+  top: -180px;
+  left: 50%;
+  transform: translateX(-50%);
+  width: min(900px, 100vw);
+  height: 600px;
+  background: radial-gradient(ellipse at 50% 30%, rgba(255, 255, 255, 0.05) 0%, transparent 70%);
+  pointer-events: none;
+  z-index: 0;
+}
+
+/* All children above the pseudo-element layers */
+.av2-layout > * {
+  position: relative;
+  z-index: 1;
+}
+
+/* ---------------------------------------------------------------------------
+   Floating pill navbar
+   --------------------------------------------------------------------------- */
+
+.av2-navbar {
+  width: 100%;
+  display: flex;
+  justify-content: center;
+  padding: 20px 24px 0;
+  flex-shrink: 0;
+}
+
+.av2-navbar-inner {
+  display: flex;
+  align-items: center;
+  gap: 0;
+  background: rgba(255, 255, 255, 0.04);
+  border: 1px solid var(--av2-border);
+  border-radius: var(--av2-radius-pill);
+  backdrop-filter: blur(12px);
+  -webkit-backdrop-filter: blur(12px);
+  padding: 6px 6px 6px 16px;
+  max-width: 680px;
+  width: 100%;
+}
+
+/* Brand */
+.av2-brand {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  text-decoration: none;
+  color: var(--av2-text);
+  font-size: 14px;
+  font-weight: 500;
+  letter-spacing: -0.2px;
+  flex-shrink: 0;
+  padding: 4px 0;
+  transition: opacity var(--av2-transition);
+}
+
+.av2-brand:hover {
+  opacity: 0.8;
+}
+
+.av2-brand-dot {
+  width: 22px;
+  height: 22px;
+  background: radial-gradient(
+    circle at 35% 35%,
+    rgba(255, 255, 255, 0.9) 0%,
+    rgba(255, 255, 255, 0.3) 60%,
+    transparent 100%
+  );
+  border-radius: 50%;
+  border: 1px solid rgba(255, 255, 255, 0.3);
+  flex-shrink: 0;
+}
+
+/* Center nav links */
+.av2-nav-links {
+  display: flex;
+  align-items: center;
+  gap: 2px;
+  flex: 1;
+  justify-content: center;
+}
+
+.av2-nav-link {
+  font-size: 14px;
+  color: var(--av2-text-sub);
+  text-decoration: none;
+  padding: 6px 14px;
+  border-radius: var(--av2-radius-pill);
+  transition:
+    color var(--av2-transition),
+    background var(--av2-transition);
+  white-space: nowrap;
+}
+
+.av2-nav-link:hover,
+.av2-nav-link:focus-visible {
+  color: var(--av2-text);
+  background: var(--av2-surface);
+}
+
+.av2-nav-link:focus-visible {
+  outline: 2px solid rgba(255, 255, 255, 0.4);
+  outline-offset: 0px;
+}
+
+/* Right action buttons */
+.av2-nav-actions {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  flex-shrink: 0;
+  margin-left: 4px;
+}
+
+.av2-nav-login {
+  font-size: 13px;
+  font-weight: 500;
+  color: var(--av2-text-sub);
+  text-decoration: none;
+  padding: 7px 14px;
+  border-radius: var(--av2-radius-pill);
+  transition:
+    color var(--av2-transition),
+    background var(--av2-transition);
+}
+
+.av2-nav-login:hover,
+.av2-nav-login:focus-visible {
+  color: var(--av2-text);
+  background: var(--av2-surface);
+}
+
+.av2-nav-login:focus-visible {
+  outline: 2px solid rgba(255, 255, 255, 0.4);
+  outline-offset: 0px;
+}
+
+.av2-nav-signup {
+  font-size: 13px;
+  font-weight: 600;
+  color: #000;
+  background: #fff;
+  text-decoration: none;
+  padding: 7px 16px;
+  border-radius: var(--av2-radius-pill);
+  box-shadow: 0 0 12px rgba(255, 255, 255, 0.18);
+  transition:
+    opacity var(--av2-transition),
+    box-shadow var(--av2-transition);
+}
+
+.av2-nav-signup:hover {
+  opacity: 0.9;
+  box-shadow: 0 0 20px rgba(255, 255, 255, 0.28);
+}
+
+.av2-nav-signup:focus-visible {
+  outline: 2px solid rgba(255, 255, 255, 0.6);
+  outline-offset: 2px;
+}
+
+/* ---------------------------------------------------------------------------
+   Main content area — centers the auth form
+   --------------------------------------------------------------------------- */
+
+.av2-content {
+  flex: 1;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 100%;
+  padding: 40px 24px 60px;
+}
+
+/* The auth "card" — glass-like, no big white box */
+.av2-card {
+  width: 100%;
+  max-width: 440px;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 0;
+}
+
+/* ---------------------------------------------------------------------------
+   Auth headings
+   --------------------------------------------------------------------------- */
+
+.av2-heading {
+  font-size: clamp(32px, 5vw, 44px);
+  font-weight: 700;
+  color: var(--av2-text);
+  letter-spacing: -1.2px;
+  margin: 0 0 10px;
+  text-align: center;
+  line-height: 1.1;
+  font-family: var(--heading);
+}
+
+.av2-subtext {
+  font-size: 16px;
+  color: var(--av2-text-sub);
+  text-align: center;
+  margin: 0 0 36px;
+  line-height: 1.5;
+}
+
+/* ---------------------------------------------------------------------------
+   Google Sign-In button
+   --------------------------------------------------------------------------- */
+
+.av2-google-btn {
+  width: 100%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  font-family: var(--sans);
+  font-size: 15px;
+  font-weight: 500;
+  color: var(--av2-text);
+  background: var(--av2-surface);
+  border: 1px solid var(--av2-border);
+  border-radius: var(--av2-radius-pill);
+  padding: 14px 20px;
+  cursor: pointer;
+  transition:
+    background var(--av2-transition),
+    border-color var(--av2-transition);
+  text-decoration: none;
+  margin-bottom: 0;
+}
+
+.av2-google-btn:hover:not(:disabled) {
+  background: var(--av2-surface-hov);
+  border-color: var(--av2-border-hov);
+}
+
+.av2-google-btn:focus-visible {
+  outline: 2px solid rgba(255, 255, 255, 0.4);
+  outline-offset: 2px;
+}
+
+.av2-google-btn:disabled {
+  opacity: 0.45;
+  cursor: not-allowed;
+}
+
+/* Google "G" icon */
+.av2-google-icon {
+  width: 18px;
+  height: 18px;
+  flex-shrink: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+/* ---------------------------------------------------------------------------
+   Or divider
+   --------------------------------------------------------------------------- */
+
+.av2-divider {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  width: 100%;
+  margin: 22px 0;
+  color: var(--av2-text-muted);
+  font-size: 13px;
+  letter-spacing: 0.3px;
+}
+
+.av2-divider::before,
+.av2-divider::after {
+  content: '';
+  flex: 1;
+  height: 1px;
+  background: var(--av2-border);
+}
+
+/* ---------------------------------------------------------------------------
+   Pill-style input row (email with → button, or password)
+   --------------------------------------------------------------------------- */
+
+.av2-form {
+  width: 100%;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+/* Input + button wrapper */
+.av2-input-row {
+  position: relative;
+  width: 100%;
+  display: flex;
+  align-items: center;
+}
+
+.av2-input {
+  width: 100%;
+  font-family: var(--sans);
+  font-size: 15px;
+  color: var(--av2-text);
+  background: var(--av2-surface);
+  border: 1px solid var(--av2-border);
+  border-radius: var(--av2-radius-pill);
+  padding: 14px 56px 14px 22px;
+  outline: none;
+  transition:
+    border-color var(--av2-transition),
+    box-shadow var(--av2-transition);
+  box-sizing: border-box;
+  -webkit-font-smoothing: antialiased;
+}
+
+.av2-input::placeholder {
+  color: var(--av2-text-muted);
+}
+
+.av2-input:focus {
+  border-color: rgba(255, 255, 255, 0.3);
+  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.06);
+}
+
+.av2-input--error {
+  border-color: var(--av2-error-border) !important;
+}
+
+.av2-input--error:focus {
+  box-shadow: 0 0 0 3px var(--av2-error-bg) !important;
+}
+
+.av2-input:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+
+/* Arrow / action button inside input row */
+.av2-arrow-btn {
+  position: absolute;
+  right: 6px;
+  width: 36px;
+  height: 36px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: rgba(255, 255, 255, 0.12);
+  border: 1px solid rgba(255, 255, 255, 0.15);
+  border-radius: 50%;
+  cursor: pointer;
+  color: var(--av2-text);
+  font-size: 16px;
+  transition:
+    background var(--av2-transition),
+    transform var(--av2-transition);
+  flex-shrink: 0;
+}
+
+.av2-arrow-btn:hover:not(:disabled) {
+  background: rgba(255, 255, 255, 0.22);
+  transform: scale(1.05);
+}
+
+.av2-arrow-btn:focus-visible {
+  outline: 2px solid rgba(255, 255, 255, 0.5);
+  outline-offset: 2px;
+}
+
+.av2-arrow-btn:disabled {
+  opacity: 0.4;
+  cursor: not-allowed;
+}
+
+/* Toggle password visibility inside pill input */
+.av2-pw-toggle {
+  position: absolute;
+  right: 50px;
+  background: none;
+  border: none;
+  color: var(--av2-text-muted);
+  font-size: 12px;
+  font-weight: 500;
+  font-family: var(--sans);
+  cursor: pointer;
+  padding: 4px 6px;
+  border-radius: 4px;
+  transition: color var(--av2-transition);
+}
+
+.av2-pw-toggle:hover {
+  color: var(--av2-text);
+}
+
+.av2-pw-toggle:focus-visible {
+  outline: 2px solid rgba(255, 255, 255, 0.4);
+  outline-offset: 2px;
+}
+
+/* ---------------------------------------------------------------------------
