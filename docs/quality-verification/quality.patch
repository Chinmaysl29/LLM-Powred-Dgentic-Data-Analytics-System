+// ---------------------------------------------------------------------------
+// Card 08 — Pairwise summary (no observation coordinates)
+// ---------------------------------------------------------------------------
+function Card08Scatter({ results }: { results: EDAResults }) {
+  const numCols = Object.keys(results.statistics);
