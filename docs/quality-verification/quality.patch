+                disabled={busy}
+                onClick={() => {
+                  setError('');
+                  setBusy(true);
+                  setRevision((v) => v + 1);
+                }}
+              >
+                Retry dataset connection
+              </button>
+            </div>
+          )}
+          {notice && <p role="status">{notice}</p>}
+          {busy && <p role="status">Waiting for the dataset or dashboard service…</p>}
+          {!busy && !datasets.length && !error && (
+            <div className="mem-empty">
+              <h2>No datasets uploaded yet.</h2>
+              <p>Upload a dataset to create your first dashboard.</p>
+              <Link className="btn btn--primary" to="/datasets">
+                Open datasets
+              </Link>
+            </div>
+          )}
+          {snapshot && (
+            <section>
+              <h2>{snapshot.title}</h2>
+              <p className="page-subtitle">
