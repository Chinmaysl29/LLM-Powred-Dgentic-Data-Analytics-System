+                    </div>
+                  </article>
+                ))}
+              </div>
+              {snapshot.charts && snapshot.charts.length > 0 && (
+                <div className="dashboard-charts-grid" style={{ marginTop: 24 }}>
+                  {snapshot.charts.map((chart) => (
+                    <div key={chart.id} className="ds-widget" style={{ padding: 16 }}>
+                      <h3 className="ds-kpi-label" style={{ marginBottom: 12 }}>
+                        {chart.title}
+                      </h3>
+                      <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
+                        {chart.points.slice(0, 10).map((pt, idx) => (
+                          <div
+                            key={idx}
+                            style={{
+                              display: 'flex',
+                              justifyContent: 'space-between',
+                              alignItems: 'center',
+                            }}
+                          >
+                            <span style={{ fontSize: 13, color: '#A0A090' }}>{pt.label}</span>
+                            <strong style={{ fontSize: 14 }}>
+                              {pt.value != null
+                                ? pt.value.toLocaleString(undefined, { maximumFractionDigits: 2 })
+                                : 'N/A'}
+                            </strong>
+                          </div>
+                        ))}
+                      </div>
+                    </div>
+                  ))}
+                </div>
+              )}
+            </section>
+          )}
+          {!snapshot && !busy && datasets.length > 0 && (
+            <div className="mem-empty">
+              <LayoutDashboard size={36} />
+              <h2>No dashboard created yet</h2>
+              <p>Select a dataset to calculate its summary.</p>
+            </div>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
