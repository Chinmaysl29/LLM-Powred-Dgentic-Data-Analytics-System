+              <Route path="/eda" element={<EDAStudioPage />} />
+              <Route path="/insights" element={<InsightsPage />} />
+              <Route path="/insights/what-if" element={<InsightsPage subView="what-if" />} />
+
+              {/* Output */}
+              <Route path="/reports" element={<ReportsPage />} />
