-      if (!nextX || columns[nextX] !== 'number' || nextX === nextY) {
-        const availableX = numericFields.filter((f) => f !== nextY);
-        nextX = availableX[0] ?? (numericFields[1] || nextY || '');
-      }
-      break;
-    }
-
-    case 'Heatmap': {
-      if (!nextY || columns[nextY] !== 'number') {
-        nextY = numericFields[0] ?? '';
