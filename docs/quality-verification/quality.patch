+/* ---------------------------------------------------------------------------
+   Tooltip behavior (Collapsed Sidebar)
+   Dark background, subtle border, readable text, zero layout shift
+   ------------------------------------------------------------------------- */
+
+.ws-tooltip {
+  /* Tooltip spans are conditionally rendered (only when sidebar is collapsed).
+     They are always display:block but hidden via opacity/visibility.
+     Hover/focus on the parent link reveals them via the rules below. */
+  display: block;
+  position: absolute;
+  left: calc(100% + 20px);
+  top: 50%;
+  transform: translateY(-50%) translateX(-4px);
+  background: #0f121a;
+  color: #f1f5f9;
+  border: 1px solid rgba(255, 255, 255, 0.12);
+  border-radius: 6px;
+  padding: 6px 10px;
+  font-size: 12px;
+  font-weight: 500;
+  line-height: 1.2;
+  white-space: nowrap;
+  box-shadow:
+    0 6px 18px rgba(0, 0, 0, 0.55),
+    0 0 0 1px rgba(255, 255, 255, 0.04);
+  pointer-events: none;
+  opacity: 0;
+  visibility: hidden;
+  transition:
+    opacity 0.15s ease,
+    transform 0.15s ease,
+    visibility 0.15s ease;
+  z-index: 9999;
+}
+
+/* Arrow pointing left from tooltip box */
+.ws-tooltip::before {
+  content: '';
+  position: absolute;
+  right: 100%;
+  top: 50%;
+  transform: translateY(-50%);
+  border: 4px solid transparent;
+  border-right-color: rgba(255, 255, 255, 0.12);
+}
+
+/* Reveal tooltip on hover/focus within collapsed sidebar */
+.ws-sidebar--collapsed .ws-nav-link:hover .ws-tooltip,
+.ws-sidebar--collapsed .ws-nav-link:focus-visible .ws-tooltip,
+.ws-sidebar--collapsed .ws-new-analysis:hover .ws-tooltip,
+.ws-sidebar--collapsed .ws-new-analysis:focus-visible .ws-tooltip,
+.ws-sidebar--collapsed .ws-collapse-toggle:hover .ws-tooltip,
+.ws-sidebar--collapsed .ws-collapse-toggle:focus-visible .ws-tooltip,
+.ws-sidebar--collapsed .ws-signout-btn:hover .ws-tooltip,
+.ws-sidebar--collapsed .ws-signout-btn:focus-visible .ws-tooltip {
+  opacity: 1;
+  visibility: visible;
+  transform: translateY(-50%) translateX(0);
+}
