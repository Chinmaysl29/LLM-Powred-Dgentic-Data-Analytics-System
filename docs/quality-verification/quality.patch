+
+// ==============================================================================
+// KPI GRID COMPONENT
+// ==============================================================================
+function KpiGrid({ kpis }: { kpis: KpiMetrics }) {
+  const fields = ['total', 'mean', 'median', 'min', 'max', 'count'];
+  const present = fields.filter((f) => kpis[f] !== undefined);
+  if (present.length === 0) return null;
+
+  return (
+    <div
+      style={{
+        display: 'grid',
+        gridTemplateColumns: `repeat(auto-fit, minmax(110px, 1fr))`,
+        gap: 12,
+      }}
+    >
+      {present.map((key) => {
+        const val = kpis[key];
+        const displayVal =
+          typeof val === 'number'
+            ? val % 1 !== 0
+              ? val.toLocaleString(undefined, { maximumFractionDigits: 2 })
+              : val.toLocaleString()
+            : String(val);
+
+        return (
+          <div
+            key={key}
+            style={{
+              padding: '12px 14px',
+              borderRadius: 10,
+              background: 'var(--surface-raised)',
+              border: '1px solid var(--border)',
+            }}
+          >
+            <div
+              style={{
+                fontSize: 11,
+                fontWeight: 700,
+                color: 'var(--text-muted)',
+                textTransform: 'uppercase',
+              }}
+            >
+              {key}
+            </div>
+            <div style={{ fontSize: 20, fontWeight: 700, color: 'var(--text-h)', marginTop: 4 }}>
+              {displayVal}
+            </div>
+          </div>
+        );
+      })}
+    </div>
+  );
+}
+
+// ==============================================================================
+// BAR CHART RENDERER COMPONENT: Clean, robust, verified visualization preview
+// ==============================================================================
+function BarChartRenderer({ chart }: { chart: ChartSpec }) {
+  const maxVal = Math.max(...chart.points.map((p) => p.value), 1);
+
+  return (
+    <div
+      style={{
+        padding: '16px 20px',
+        borderRadius: 12,
+        background: 'var(--surface-raised)',
+        border: '1px solid var(--border)',
+        display: 'flex',
+        flexDirection: 'column',
+        gap: 14,
+      }}
+    >
+      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
+        <span style={{ fontSize: 13, fontWeight: 600, color: 'var(--text-h)' }}>
+          {chart.chart_label || `${chart.y_field} by ${chart.x_field}`}
+        </span>
+        <span style={{ fontSize: 11, color: 'var(--text-muted)' }}>Verified Aggregate Series</span>
+      </div>
+
+      <div style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
+        {chart.points.map((pt, idx) => {
+          const pct = Math.max(0, Math.min(100, (pt.value / maxVal) * 100));
+          return (
+            <div
+              key={idx}
+              style={{
+                display: 'grid',
+                gridTemplateColumns: '160px minmax(0, 1fr) 90px',
+                gap: 12,
+                alignItems: 'center',
+              }}
+            >
+              <span
+                style={{
+                  fontSize: 12,
+                  fontWeight: 500,
+                  color: 'var(--text)',
+                  overflow: 'hidden',
+                  textOverflow: 'ellipsis',
+                  whiteSpace: 'nowrap',
+                }}
+                title={pt.label}
+              >
+                {pt.label}
+              </span>
+              <div
+                style={{
+                  height: 18,
+                  borderRadius: 4,
+                  background: 'var(--code-bg)',
+                  overflow: 'hidden',
+                  position: 'relative',
+                }}
+              >
+                <div
+                  style={{
+                    height: '100%',
+                    width: `${pct}%`,
+                    background: 'var(--brand-lime)',
+                    borderRadius: 4,
+                    transition: 'width 0.4s ease',
+                  }}
+                />
+              </div>
+              <span
+                style={{
+                  fontSize: 12,
+                  fontWeight: 600,
+                  color: 'var(--text-h)',
+                  textAlign: 'right',
+                }}
+              >
+                {pt.value.toLocaleString(undefined, { maximumFractionDigits: 2 })}
+              </span>
+            </div>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
