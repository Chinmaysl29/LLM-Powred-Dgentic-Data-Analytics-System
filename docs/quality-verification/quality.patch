+  }
+
+  .preview-footer-note {
+    padding: 10px 16px 14px;
+  }
+
+  .preview-empty {
+    padding: 32px 16px;
+  }
+}
+
+/* =========================================================================
+   Phase 2F — Datasets Page Header Row (list page + upload button)
+   ========================================================================= */
+
+/* Header row: title/description on left, Upload button on right */
+.datasets-header-row {
