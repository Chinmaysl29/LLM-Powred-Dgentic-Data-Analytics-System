+  background: rgba(74, 222, 128, 0.08);
+  border: 1px solid rgba(74, 222, 128, 0.22);
+  border-radius: 10px;
+  padding: 10px 16px;
+  font-size: 14px;
+  color: #4ade80;
+  line-height: 1.45;
+}
+
+/* ---------------------------------------------------------------------------
+   Step divider for two-step login (email → password)
+   --------------------------------------------------------------------------- */
+
+.av2-back-btn {
+  background: none;
+  border: none;
+  color: var(--av2-text-muted);
+  font-size: 13px;
+  font-family: var(--sans);
