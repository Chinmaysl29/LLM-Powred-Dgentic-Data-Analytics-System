-  --text-muted: #a6b1c2;
-  --border: #3b4355;
-  --code-bg: #1f2433;
-  --accent: #7fb5f5;
-  --accent-strong: #2563b8;
-  --accent-bg: #24364e;
-  --accent-border: #577ca8;
-  --focus: #9cc9ff;
-  --success: #84d3b0;
-  --warning: #e8c076;
-  --error: #f59c9c;
-  --chart-1: #7fb5f5;
-  --chart-2: #84d3b0;
-  --chart-3: #e8c076;
-  --chart-4: #baa5e0;
-  --social-bg: #1f2433;
-  --shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
-  --radius-control: 7px;
-  --radius-card: 10px;
-  --space-1: 4px;
-  --space-2: 8px;
-  --space-3: 12px;
-  --space-4: 16px;
-  --space-6: 24px;
-  --space-8: 32px;
-  --sans: 'Inter', system-ui, 'Segoe UI', sans-serif;
-  --heading: var(--sans);
-  --mono: ui-monospace, Consolas, monospace;
-  font: 16px/1.5 var(--sans);
-  color-scheme: dark;
-  color: var(--text);
-  background: var(--bg);
-  font-synthesis: none;
-  text-rendering: optimizeLegibility;
-  -webkit-font-smoothing: antialiased;
-  -moz-osx-font-smoothing: grayscale;
-}
-
-/* Base Layout Elements */
-#root {
-  min-height: 100svh;
-  display: flex;
-  flex-direction: column;
-  box-sizing: border-box;
-}
-
-body {
-  margin: 0;
-}
-
-h1, h2, h3 {
-  font-family: var(--heading);
-  font-weight: 500;
-  color: var(--text-h);
-}
-
-h1 {
-  font-size: 32px;
-  margin: 24px 0;
-}
-
-p {
-  margin: 0;
-}
-
-/* Auth Layout Foundation */
-.auth-layout {
-  display: flex;
-  min-height: 100svh;
-  align-items: center;
-  justify-content: center;
-  background-color: var(--bg);
-}
-
-.auth-content {
-  width: 100%;
-  max-width: 400px;
-  padding: 24px;
-}
-
-/* App Layout Foundation */
-.app-layout {
-  display: flex;
-  min-height: 100svh;
-  background-color: var(--bg);
-}
-
-.app-content {
-  flex: 1;
-  padding: 24px;
-  min-width: 0; /* prevent flex child overflow with wide tables */
-}
-
-/* Utility for generic pages */
-.not-found {
-  text-align: center;
-  margin-top: 20vh;
-}
-
-/* =========================================================================
-   Auth Form UI
-   Uses existing design tokens: --text, --text-h, --bg, --border, --accent,
-   --accent-bg, --accent-border, --shadow, --sans, --heading
-   ========================================================================= */
-
-.auth-card {
-  width: 100%;
-}
-
-.auth-brand {
-  font-family: var(--heading);
-  font-size: 20px;
-  font-weight: 600;
-  color: var(--accent);
-  letter-spacing: -0.3px;
-  margin-bottom: 32px;
-}
-
-.auth-heading {
-  font-size: 26px;
-  margin: 0 0 8px;
-}
-
-.auth-subtext {
-  color: var(--text);
-  font-size: 15px;
-  line-height: 1.5;
-  margin-bottom: 28px;
-}
-
-/* Alert / error banner */
-.auth-alert {
-  background: rgba(220, 38, 38, 0.08);
-  border: 1px solid rgba(220, 38, 38, 0.3);
-  color: #dc2626;
-  font-size: 14px;
-  line-height: 1.45;
-  padding: 10px 14px;
-  border-radius: 8px;
-  margin-bottom: 20px;
-}
-
-@media (prefers-color-scheme: dark) {
-  .auth-alert {
-    background: rgba(248, 113, 113, 0.1);
-    border-color: rgba(248, 113, 113, 0.25);
-    color: #f87171;
-  }
-}
-
-/* Form */
-.auth-form {
-  display: flex;
-  flex-direction: column;
-  gap: 18px;
-}
-
-/* Field wrapper */
-.form-field {
-  display: flex;
-  flex-direction: column;
-  gap: 6px;
-}
-
-.form-label {
-  font-size: 14px;
-  font-weight: 500;
-  color: var(--text-h);
-}
-
-/* Input */
-.form-input {
-  font-family: var(--sans);
-  font-size: 15px;
-  color: var(--text-h);
-  background: var(--bg);
-  border: 1px solid var(--border);
-  border-radius: 8px;
-  padding: 10px 12px;
-  outline: none;
-  transition: border-color 0.15s, box-shadow 0.15s;
-  width: 100%;
-  box-sizing: border-box;
-}
-
-.form-input::placeholder {
-  color: var(--text);
-  opacity: 0.55;
-}
-
-.form-input:focus {
-  border-color: var(--accent-border);
-  box-shadow: 0 0 0 3px var(--accent-bg);
-}
-
-.form-input--error {
-  border-color: #dc2626;
-}
-
-.form-input--error:focus {
-  border-color: #dc2626;
-  box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.12);
-}
-
-@media (prefers-color-scheme: dark) {
-  .form-input--error {
-    border-color: #f87171;
-  }
-
-  .form-input--error:focus {
-    box-shadow: 0 0 0 3px rgba(248, 113, 113, 0.15);
-  }
-}
-
-.form-input:disabled {
-  opacity: 0.55;
-  cursor: not-allowed;
-}
-
-/* Input group (for password + toggle) */
-.form-input-group {
-  position: relative;
-  display: flex;
-  align-items: center;
-}
-
-.form-input-group .form-input {
-  padding-right: 60px;
-}
-
-/* Password visibility toggle */
-.form-toggle-password {
-  position: absolute;
-  right: 4px;
-  background: none;
-  border: none;
-  padding: 6px 10px;
-  font-family: var(--sans);
-  font-size: 13px;
-  font-weight: 500;
-  color: var(--accent);
-  cursor: pointer;
-  border-radius: 6px;
-  transition: background-color 0.15s;
-}
-
-.form-toggle-password:hover {
-  background-color: var(--accent-bg);
-}
-
-.form-toggle-password:focus-visible {
-  outline: 2px solid var(--accent);
-  outline-offset: 2px;
-}
-
-/* Field error message */
-.form-error {
-  font-size: 13px;
-  color: #dc2626;
-  margin: 0;
-  line-height: 1.4;
-}
-
-@media (prefers-color-scheme: dark) {
-  .form-error {
-    color: #f87171;
-  }
-}
-
-/* Forgot password row */
-.auth-forgot {
-  display: flex;
-  justify-content: flex-end;
-  margin-top: -8px;
-}
-
-/* Auth links */
-.auth-link {
-  font-size: 14px;
-  font-weight: 500;
-  color: var(--accent);
-  text-decoration: none;
-  transition: opacity 0.15s;
-}
-
-.auth-link:hover {
-  opacity: 0.8;
-}
-
-.auth-link:focus-visible {
-  outline: 2px solid var(--accent);
-  outline-offset: 2px;
-  border-radius: 2px;
-}
-
-/* Submit button */
-.auth-submit {
-  font-family: var(--sans);
-  font-size: 15px;
-  font-weight: 600;
-  color: #fff;
-  background: var(--accent);
-  border: none;
-  border-radius: 8px;
-  padding: 11px 20px;
-  cursor: pointer;
-  display: inline-flex;
-  align-items: center;
-  justify-content: center;
-  gap: 8px;
-  transition: opacity 0.15s;
-  margin-top: 4px;
-}
-
-.auth-submit:hover:not(:disabled) {
-  opacity: 0.88;
-}
-
-.auth-submit:focus-visible {
-  outline: 2px solid var(--accent);
-  outline-offset: 2px;
-}
-
-.auth-submit:disabled {
-  opacity: 0.6;
-  cursor: not-allowed;
-}
-
-/* Loading spinner */
-.auth-spinner {
-  display: inline-block;
-  width: 16px;
-  height: 16px;
-  border: 2px solid rgba(255, 255, 255, 0.3);
-  border-top-color: #fff;
-  border-radius: 50%;
-  animation: auth-spin 0.6s linear infinite;
-}
-
-@keyframes auth-spin {
-  to {
-    transform: rotate(360deg);
-  }
-}
-
-/* Footer (signup prompt) */
-.auth-footer {
-  text-align: center;
-  font-size: 14px;
-  color: var(--text);
-  margin-top: 24px;
-}
-
-/* Responsive: tighten spacing on small screens */
-@media (max-width: 480px) {
-  .auth-content {
-    padding: 20px 16px;
-  }
-
-  .auth-heading {
-    font-size: 22px;
-  }
-
-  .auth-brand {
-    margin-bottom: 24px;
-  }
-}
-
-/* =========================================================================
-   App Shell — Sidebar Navigation
-   Uses existing design tokens only. No new variables introduced.
-   ========================================================================= */
-
-.app-sidebar {
-  width: 220px;
-  flex-shrink: 0;
-  border-right: 1px solid var(--border);
-  display: flex;
-  flex-direction: column;
-  background: var(--bg);
-  position: sticky;
-  top: 0;
-  height: 100svh;
-  overflow-y: auto;
-}
-
-.app-sidebar-brand {
-  font-family: var(--heading);
-  font-size: 14px;
-  font-weight: 600;
-  color: var(--accent);
-  letter-spacing: -0.1px;
-  padding: 20px 16px 16px;
-  border-bottom: 1px solid var(--border);
-  white-space: nowrap;
-  flex-shrink: 0;
-}
-
-.app-nav {
-  list-style: none;
-  margin: 0;
-  padding: 10px 8px;
-  display: flex;
-  flex-direction: column;
-  gap: 2px;
-  flex: 1;
-}
-
-.app-nav li {
-  display: block;
-}
-
-.app-nav-link {
-  display: flex;
-  align-items: center;
-  gap: 10px;
-  padding: 8px 10px;
-  border-radius: 7px;
-  font-size: 14px;
-  font-weight: 500;
-  color: var(--text);
-  text-decoration: none;
-  transition: background-color 0.12s, color 0.12s;
-  line-height: 1;
-}
-
-.app-nav-link:hover {
-  background-color: var(--accent-bg);
-  color: var(--text-h);
-}
-
-/* React Router sets aria-current="page" on active NavLink automatically */
-.app-nav-link[aria-current='page'] {
-  background-color: var(--accent-bg);
-  color: var(--accent);
-}
-
-.app-nav-link:focus-visible {
-  outline: 2px solid var(--accent);
-  outline-offset: 2px;
-}
-
-.app-nav-icon {
-  display: flex;
-  align-items: center;
-  justify-content: center;
-  flex-shrink: 0;
-  opacity: 0.6;
-  transition: opacity 0.12s;
-}
-
-.app-nav-link:hover .app-nav-icon,
-.app-nav-link[aria-current='page'] .app-nav-icon {
-  opacity: 1;
-}
-
-/* Mobile: sidebar collapses into a horizontal top bar */
-@media (max-width: 768px) {
-  .app-layout {
-    flex-direction: column;
-  }
-
-  .app-sidebar {
-    width: 100%;
-    height: auto;
-    position: static;
-    flex-direction: row;
-    align-items: center;
-    border-right: none;
-    border-bottom: 1px solid var(--border);
-  }
-
-  .app-sidebar-brand {
-    border-bottom: none;
-    border-right: 1px solid var(--border);
-    padding: 12px 16px;
-  }
-
-  .app-nav {
-    flex-direction: row;
-    padding: 8px;
-    gap: 4px;
-    overflow-x: auto;
-    flex: 1;
-  }
-
-  .app-content {
-    padding: 20px 16px;
-  }
-}
-
-/* =========================================================================
-   Page Layout — Shared page header used across app pages
-   ========================================================================= */
-
-.page-header {
-  margin-bottom: 28px;
-}
-
-.page-title {
-  font-family: var(--heading);
-  font-size: 24px;
-  font-weight: 600;
-  color: var(--text-h);
-  margin: 0 0 6px;
-  line-height: 1.25;
-}
-
-.page-description {
-  font-size: 14px;
-  color: var(--text);
-  margin: 0;
-  line-height: 1.55;
-}
-
-/* =========================================================================
-   Dataset Summary Bar
-   ========================================================================= */
-
-.dataset-summary {
-  display: flex;
-  align-items: center;
-  gap: 32px;
-  background: var(--code-bg);
-  border: 1px solid var(--border);
-  border-radius: 10px;
-  padding: 16px 20px;
-  margin-bottom: 24px;
-}
-
-.dataset-stat {
-  display: flex;
-  flex-direction: column;
-  gap: 3px;
-}
-
-.dataset-stat-value {
-  font-family: var(--heading);
-  font-size: 26px;
-  font-weight: 600;
-  color: var(--text-h);
-  line-height: 1;
-}
-
-.dataset-stat-label {
-  font-size: 11px;
-  color: var(--text);
-  text-transform: uppercase;
-  letter-spacing: 0.7px;
-  font-weight: 500;
-}
-
-/* =========================================================================
-   Dataset Table
-   ========================================================================= */
-
-.dataset-table-wrapper {
-  border: 1px solid var(--border);
-  border-radius: 10px;
-  overflow-x: auto;
-}
-
-.dataset-table {
-  width: 100%;
-  border-collapse: collapse;
-  font-size: 14px;
-  min-width: 500px;
-}
-
-.dataset-table thead {
-  background: var(--code-bg);
-}
-
-.dataset-table thead tr {
-  border-bottom: 1px solid var(--border);
-}
-
-.dataset-table th {
-  padding: 11px 16px;
-  text-align: left;
-  font-size: 11px;
-  font-weight: 600;
-  color: var(--text);
-  text-transform: uppercase;
-  letter-spacing: 0.6px;
-  white-space: nowrap;
-}
-
-.dataset-table th:last-child {
-  text-align: right;
-}
-
-.dataset-table td {
-  padding: 14px 16px;
-  border-bottom: 1px solid var(--border);
-  vertical-align: middle;
-}
-
-.dataset-table tbody tr:last-child td {
-  border-bottom: none;
-}
-
-.dataset-table tbody tr:hover {
-  background-color: var(--accent-bg);
-  transition: background-color 0.1s;
-}
-
-/* Dataset name + extension */
-.dataset-filename {
-  font-weight: 500;
-  color: var(--text-h);
-  display: block;
-  line-height: 1.35;
-  word-break: break-word;
-}
-
-.dataset-filetype {
-  font-size: 11px;
-  font-weight: 600;
-  color: var(--text);
-  text-transform: uppercase;
-  letter-spacing: 0.5px;
-  margin-top: 2px;
-  display: block;
-  font-family: var(--mono);
-}
-
-/* Size and date metadata */
-.dataset-meta {
-  color: var(--text);
-  white-space: nowrap;
-  font-variant-numeric: tabular-nums;
-}
-
-/* Row action area — reserved space for Phase 2E/2F buttons */
-.dataset-actions {
-  display: flex;
-  align-items: center;
-  gap: 6px;
-  justify-content: flex-end;
-  min-height: 28px;
-}
-
-/* =========================================================================
-   Status Badges
-   Semantic: dot + text label — does not rely on color alone.
-   ========================================================================= */
-
-.status-badge {
-  display: inline-flex;
-  align-items: center;
-  gap: 6px;
-  font-size: 12px;
-  font-weight: 500;
-  padding: 3px 10px;
-  border-radius: 20px;
-  white-space: nowrap;
-  line-height: 1.6;
-}
-
-.status-badge::before {
-  content: '';
-  display: inline-block;
-  width: 6px;
-  height: 6px;
-  border-radius: 50%;
-  flex-shrink: 0;
-}
-
-.status-badge--uploaded    { background: rgba(99, 102, 241, 0.12); color: #4f46e5; }
-.status-badge--validating  { background: rgba(245, 158, 11, 0.12); color: #b45309; }
-.status-badge--validated   { background: rgba(20, 184, 166, 0.12); color: #0f766e; }
-.status-badge--processing  { background: rgba(59, 130, 246, 0.12); color: #1d4ed8; }
-.status-badge--processed   { background: rgba(34, 197, 94, 0.12);  color: #15803d; }
-.status-badge--failed      { background: rgba(239, 68, 68, 0.12);  color: #dc2626; }
-
-.status-badge--uploaded::before    { background: #4f46e5; }
-.status-badge--validating::before  { background: #b45309; }
-.status-badge--validated::before   { background: #0f766e; }
-.status-badge--processing::before  { background: #1d4ed8; }
-.status-badge--processed::before   { background: #15803d; }
-.status-badge--failed::before      { background: #dc2626; }
-
-@media (prefers-color-scheme: dark) {
-  .status-badge--uploaded    { background: rgba(99,  102, 241, 0.18); color: #818cf8; }
-  .status-badge--validating  { background: rgba(245, 158,  11, 0.18); color: #fbbf24; }
-  .status-badge--validated   { background: rgba( 20, 184, 166, 0.18); color: #2dd4bf; }
-  .status-badge--processing  { background: rgba( 59, 130, 246, 0.18); color: #60a5fa; }
-  .status-badge--processed   { background: rgba( 34, 197,  94, 0.18); color: #4ade80; }
-  .status-badge--failed      { background: rgba(239,  68,  68, 0.18); color: #f87171; }
-
-  .status-badge--uploaded::before    { background: #818cf8; }
-  .status-badge--validating::before  { background: #fbbf24; }
-  .status-badge--validated::before   { background: #2dd4bf; }
-  .status-badge--processing::before  { background: #60a5fa; }
-  .status-badge--processed::before   { background: #4ade80; }
-  .status-badge--failed::before      { background: #f87171; }
-}
-
-/* =========================================================================
-   Empty State
-   ========================================================================= */
-
-.dataset-empty {
-  display: flex;
-  flex-direction: column;
-  align-items: center;
-  justify-content: center;
-  padding: 72px 24px;
-  text-align: center;
-}
-
-.dataset-empty-icon {
-  color: var(--text);
-  opacity: 0.3;
-  margin-bottom: 20px;
-}
-
-.dataset-empty-title {
-  font-family: var(--heading);
-  font-size: 17px;
-  font-weight: 600;
-  color: var(--text-h);
-  margin: 0 0 8px;
-}
-
-.dataset-empty-body {
-  font-size: 14px;
-  color: var(--text);
-  margin: 0;
-  max-width: 340px;
-  line-height: 1.6;
-}
-
-/* =========================================================================
-   Loading State — Skeleton Rows
-   ========================================================================= */
-
-.dataset-skeleton {
-  padding: 0;
-}
-
-.dataset-skeleton-row {
-  display: flex;
-  align-items: center;
-  gap: 16px;
-  padding: 18px 16px;
-  border-bottom: 1px solid var(--border);
-}
-
-.dataset-skeleton-row:last-child {
-  border-bottom: none;
-}
-
-.skeleton-block {
-  height: 13px;
-  border-radius: 6px;
-  background: var(--border);
-  animation: skeleton-pulse 1.5s ease-in-out infinite;
-}
-
-@keyframes skeleton-pulse {
-  0%, 100% { opacity: 1; }
-  50%       { opacity: 0.35; }
-}
-
-/* =========================================================================
-   Error State
-   ========================================================================= */
-
-.dataset-error {
-  background: rgba(220, 38, 38, 0.08);
-  border: 1px solid rgba(220, 38, 38, 0.3);
-  color: #dc2626;
-  font-size: 14px;
-  padding: 14px 16px;
-  border-radius: 8px;
-  line-height: 1.55;
-}
-
-@media (prefers-color-scheme: dark) {
-  .dataset-error {
-    background: rgba(248, 113, 113, 0.1);
-    border-color: rgba(248, 113, 113, 0.25);
-    color: #f87171;
-  }
-}
-
-/* =========================================================================
-   Screen-reader utility (used by table Actions header)
-   ========================================================================= */
-
-.sr-only {
-  position: absolute;
-  width: 1px;
-  height: 1px;
-  padding: 0;
-  margin: -1px;
-  overflow: hidden;
-  clip: rect(0, 0, 0, 0);
-  clip-path: inset(50%);
-  white-space: nowrap;
-  border: 0;
-}
-
-/* =========================================================================
-   Phase 2C — Dataset Search / Filter / Sort Controls
-   Uses existing design tokens only. No new CSS variables introduced.
-   ========================================================================= */
-
-.dataset-controls {
-  display: flex;
-  flex-wrap: wrap;
-  align-items: flex-end;
-  gap: 12px;
-  margin-bottom: 16px;
-}
-
-/* Individual labeled control group */
-.dataset-control-field {
-  display: flex;
-  flex-direction: column;
-  gap: 5px;
-  min-width: 0;
-}
-
-/* Vertically centers the clear button with other controls */
-.dataset-control-field--clear {
-  justify-content: flex-end;
-}
-
-.dataset-control-label {
-  font-size: 12px;
-  font-weight: 600;
-  color: var(--text);
-  text-transform: uppercase;
-  letter-spacing: 0.55px;
-  white-space: nowrap;
-}
-
-/* Search input wrapper — positions the magnifier icon */
-.dataset-search-wrapper {
-  position: relative;
-  display: flex;
-  align-items: center;
-}
-
-.dataset-search-icon {
-  position: absolute;
-  left: 10px;
-  color: var(--text);
-  opacity: 0.5;
-  pointer-events: none;
-  flex-shrink: 0;
-}
-
-.dataset-search-input {
-  font-family: var(--sans);
-  font-size: 14px;
-  color: var(--text-h);
