+
+  if (numCols.length < 2) return null;
+
+  // We don't have raw row data here — show statistical summary as proxy
+  const corrVal =
+    xCol !== yCol ? (results.correlations.correlation_matrix[xCol]?.[yCol] ?? null) : null;
